{
 "steps": [
  {
   "id": "step-1",
   "number": 1,
   "name": "Lấy access token (client_credentials của auth)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988195,
    "name": "Lấy access token (client_credentials của auth)",
    "path": "{{authUrl}}/oauth2/token",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "x-www-form-urlencoded",
     "parameters": [
      {
       "name": "grant_type",
       "value": "client_credentials",
       "enable": true,
       "type": "string"
      },
      {
       "name": "client_id",
       "value": "{{clientId}}",
       "enable": true,
       "type": "string"
      },
      {
       "name": "client_secret",
       "value": "{{clientSecret}}",
       "enable": true,
       "type": "string"
      }
     ]
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.access_token exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$.access_token",
       "value": "",
       "extractSettings": {
        "expression": "$.access_token"
       }
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const tok = pm.response.json().access_token; pm.variables.set('accessToken', tok);\ntry { const p = JSON.parse(atob(tok.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))); pm.variables.set('projectId', p.fhir_project || ''); } catch (e) { pm.variables.set('projectId', ''); }\nconst base = '1.2.826.0.1.3680043.9.7777.' + Date.now() + (100 + Math.floor(Math.random() * 900));\npm.variables.set('studyUid', base + '.1'); pm.variables.set('seriesUid', base + '.1.1'); pm.variables.set('sop1', base + '.1.1.1'); pm.variables.set('sop2', base + '.1.1.2');\npm.variables.set('series2Uid', base + '.1.2'); pm.variables.set('sop3', base + '.1.2.1'); pm.variables.set('otherStudyUid', base + '.9');\npm.variables.set('pid', 'QA-' + Date.now());"
     }
    ],
    "auth": {
     "type": "noauth"
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988195
  },
  {
   "id": "step-2",
   "number": 2,
   "name": "Seed: STOW study cố định",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988194,
    "name": "Seed: STOW study cố định",
    "path": "/dicomweb/studies",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [
      {
       "name": "Content-Type",
       "value": "multipart/related; type=\"application/dicom+json\"; boundary=qa-bnd",
       "enable": true
      }
     ],
     "cookie": []
    },
    "requestBody": {
     "type": "raw",
     "data": "--qa-bnd\r\nContent-Type: application/dicom+json\r\n\r\n[{\"00080016\":{\"vr\":\"UI\",\"Value\":[\"1.2.840.10008.5.1.4.1.1.2\"]},\"00080018\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.200.1.1.1\"]},\"00080060\":{\"vr\":\"CS\",\"Value\":[\"CT\"]},\"00080020\":{\"vr\":\"DA\",\"Value\":[\"20240102\"]},\"00100010\":{\"vr\":\"PN\",\"Value\":[{\"Alphabetic\":\"Qa^Retrieve\"}]},\"00100020\":{\"vr\":\"LO\",\"Value\":[\"QA-RETRIEVE\"]},\"0020000D\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.200.1\"]},\"0020000E\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.200.1.1\"]},\"00280002\":{\"vr\":\"US\",\"Value\":[1]},\"00280004\":{\"vr\":\"CS\",\"Value\":[\"MONOCHROME2\"]},\"00280008\":{\"vr\":\"IS\",\"Value\":[\"3\"]},\"00280010\":{\"vr\":\"US\",\"Value\":[2]},\"00280011\":{\"vr\":\"US\",\"Value\":[2]},\"00280100\":{\"vr\":\"US\",\"Value\":[8]},\"00280101\":{\"vr\":\"US\",\"Value\":[8]},\"00280102\":{\"vr\":\"US\",\"Value\":[7]},\"00280103\":{\"vr\":\"US\",\"Value\":[0]},\"7FE00010\":{\"vr\":\"OB\",\"BulkDataURI\":\"urn:qa:rm\"}},{\"00080016\":{\"vr\":\"UI\",\"Value\":[\"1.2.840.10008.5.1.4.1.1.88.11\"]},\"00080018\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.200.1.2.1\"]},\"00080060\":{\"vr\":\"CS\",\"Value\":[\"SR\"]},\"00080020\":{\"vr\":\"DA\",\"Value\":[\"20240102\"]},\"00100010\":{\"vr\":\"PN\",\"Value\":[{\"Alphabetic\":\"Qa^Retrieve\"}]},\"00100020\":{\"vr\":\"LO\",\"Value\":[\"QA-RETRIEVE\"]},\"0020000D\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.200.1\"]},\"0020000E\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.200.1.2\"]}}]\r\n--qa-bnd\r\nContent-Location: urn:qa:rm\r\nContent-Type: application/octet-stream\r\n\r\nABCDEFGHIJKL\r\n--qa-bnd--\r\n"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{accessToken}}"
     }
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988194
  },
  {
   "id": "step-3",
   "number": 3,
   "name": "GET theo dữ liệu",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988193,
    "name": "GET theo dữ liệu",
    "path": "{{dicomUrl}}{{req_path}}",
    "method": "get",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [
      {
       "name": "Accept",
       "value": "{{accept}}",
       "enable": true
      }
     ],
     "cookie": []
    },
    "requestBody": {
     "type": "none"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == {{expected_status}}",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "{{expected_status}}"
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const m = pm.iterationData.get('expected_message'); if (m) { pm.test('error = ' + m, () => pm.expect(pm.response.json().error).to.eql(m)); }"
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const c = pm.iterationData.get('expected_ct'); if (c) { pm.test('Content-Type chứa ' + c, () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include(c)); }"
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const b = pm.iterationData.get('expect_body'); if (b) { pm.test('body chứa ' + b, () => pm.expect(pm.response.text()).to.include(b)); }"
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{accessToken}}"
     }
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988193
  }
 ]
}
