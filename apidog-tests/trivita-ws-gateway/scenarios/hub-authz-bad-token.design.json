{
 "slug": "hub-authz-bad-token",
 "name": "Hub authz: token sai",
 "priority": 1,
 "steps": [
  {
   "name": "POST /fhircast/STU3 token sai",
   "endpointId": 47548550,
   "method": "POST",
   "path": "/fhircast/STU3",
   "auth": "Bearer {{credential}}",
   "body": "{\"hub.channel.type\":\"websocket\",\"hub.mode\":\"subscribe\",\"hub.topic\":\"qa-noauth\",\"hub.events\":\"Patient-open\"}",
   "assertions": [
    "status == {{expected_status}}"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('WWW-Authenticate: Bearer realm=\"fhircast\"', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.eql('Bearer realm=\"fhircast\"'));"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "if (pm.response.code >= 400) { pm.test('lỗi là OperationOutcome', () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/fhir+json'); pm.expect(pm.response.json().resourceType).to.eql('OperationOutcome'); }); }"
     }
    }
   ]
  },
  {
