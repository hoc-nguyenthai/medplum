{
 "steps": [
  {
   "id": "step-1",
   "number": 1,
   "name": "Đăng nhập admin project (auth /auth/login)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988155,
    "name": "Đăng nhập admin project (auth /auth/login)",
    "path": "{{authUrl}}/auth/login",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "json",
     "data": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.code exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$.code",
       "value": "",
       "extractSettings": {
        "expression": "$.code"
       }
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "adm_code",
       "expression": "$.code",
       "subject": "responseJson"
      }
     }
    ],
    "auth": {
     "type": "noauth"
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988155
  },
  {
   "id": "step-2",
   "number": 2,
   "name": "Đổi code lấy token admin (authorization_code)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988154,
    "name": "Đổi code lấy token admin (authorization_code)",
    "path": "{{authUrl}}/oauth2/token",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "x-www-form-urlencoded",
     "parameters": [
      {
       "name": "grant_type",
       "value": "authorization_code",
       "enable": true,
       "type": "string"
      },
      {
       "name": "code",
       "value": "{{adm_code}}",
       "enable": true,
       "type": "string"
      },
      {
       "name": "client_id",
       "value": "{{clientId}}",
       "enable": true,
       "type": "string"
      },
      {
       "name": "client_secret",
       "value": "{{clientSecret}}",
       "enable": true,
       "type": "string"
      }
     ]
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.access_token exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$.access_token",
       "value": "",
       "extractSettings": {
        "expression": "$.access_token"
       }
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "bearerToken",
       "expression": "$.access_token",
       "subject": "responseJson"
      }
     }
    ],
    "auth": {
     "type": "noauth"
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988154
  },
  {
   "id": "step-3",
   "number": 3,
   "name": "(setup) POST Patient (đảm bảo có dữ liệu)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988153,
    "name": "(setup) POST Patient (đảm bảo có dữ liệu)",
    "path": "/fhir/R4/Patient",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "json",
     "data": "{\"resourceType\": \"Patient\", \"name\": [{\"family\": \"Bx-{{$timestamp}}\", \"given\": [\"Qa\"]}]}"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 201",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "201"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.id exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$.id",
       "value": "",
       "extractSettings": {
        "expression": "$.id"
       }
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "patient_id",
       "expression": "$.id",
       "subject": "responseJson"
      }
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{bearerToken}}"
     }
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988153
  },
  {
   "id": "step-4",
   "number": 4,
   "name": "GET $export (Prefer: respond-async)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988152,
    "name": "GET $export (Prefer: respond-async)",
    "path": "/fhir/R4/$export?_type=Patient&_outputFormat=ndjson",
    "method": "get",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [
      {
       "name": "Prefer",
       "value": "respond-async",
       "enable": true
      }
     ],
     "cookie": []
    },
    "requestBody": {
     "type": "none"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 202",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "202"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.resourceType == OperationOutcome",
       "subject": "responseJson",
       "comparison": "equal",
       "path": "$.resourceType",
       "value": "OperationOutcome",
       "extractSettings": {
        "expression": "$.resourceType"
       }
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const loc = pm.response.headers.get('Content-Location') || ''; const m = loc.match(/bulkdata\\/([^\\/]+)\\/status/); pm.test('Content-Location có id job', () => pm.expect(m).to.not.eql(null)); if (m) { pm.variables.set('job_id', m[1]); }"
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{bearerToken}}"
     }
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988152
  },
