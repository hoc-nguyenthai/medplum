   "number": 3,
   "name": "GET Patient với token hợp lệ (đối chứng)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988032,
    "name": "GET Patient với token hợp lệ (đối chứng)",
    "path": "/fhir/R4/Patient?_count=1",
    "method": "get",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "none"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     }
    ],
    "auth": {
