{"slug": "auth-negative-misc", "name": "Auth | Phản hồi lỗi chung: Content-Type, thiếu Bearer, introspect rỗng", "priority": 1, "steps": [{"name": "Token với Content-Type JSON → 400 văn bản", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "headers": {"Content-Type": "application/json"}, "body": "{\"grant_type\": \"client_credentials\"}", "assertions": ["status == 400"], "postProcessors": [{"type": "customScript", "data": {"script": "pm.test('thân là Unsupported content type', () => pm.expect(pm.response.text()).to.include('Unsupported content type'));"}}]}, {"name": "GET /auth/me không Authorization → 401 + WWW-Authenticate", "endpointId": 47548454, "method": "GET", "path": "/auth/me", "auth": "none", "assertions": ["status == 401", "$.issue[0].code == login"], "postProcessors": [{"type": "customScript", "data": {"script": "pm.test('WWW-Authenticate Bearer realm=auth', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer realm=\"auth\"'));"}}, {"type": "customScript", "data": {"script": "pm.test('Cache-Control no-store', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));"}}, {"type": "customScript", "data": {"script": "pm.test('X-Content-Type-Options nosniff', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));"}}, {"type": "customScript", "data": {"script": "pm.test('có X-Request-Id', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);"}}]}, {"name": "Lấy token client_credentials", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "client_credentials", "client_id": "{{clientId}}", "client_secret": "{{clientSecret}}"}, "assertions": ["status == 200", "$.access_token exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "ccToken", "expression": "$.access_token", "subject": "responseJson"}}]}, {"name": "Introspect không có token → 400 văn bản", "endpointId": 47548478, "method": "POST", "path": "/oauth2/introspect", "form": {"token": ""}, "auth": "Bearer {{ccToken}}", "assertions": ["status == 400"], "postProcessors": [{"type": "customScript", "data": {"script": "pm.test('Token to introspect must be provided', () => pm.expect(pm.response.text()).to.include('Token to introspect must be provided'));"}}]}, {"name": "Introspect token lạ → active:false", "endpointId": 47548478, "method": "POST", "path": "/oauth2/introspect", "form": {"token": "khong-phai-token"}, "auth": "Bearer {{ccToken}}", "assertions": ["status == 200", "$.active == false"]}, {"name": "Introspect id_token/rác không lộ thông tin: một khóa duy nhất", "endpointId": 47548478, "method": "POST", "path": "/oauth2/introspect", "form": {"token": "a.b.c"}, "auth": "Bearer {{ccToken}}", "assertions": ["status == 200", "$.active == false", "$.iss not exists"]}, {"name": "GET /oauth2/logout thu hồi login", "endpointId": 47548479, "method": "GET", "path": "/oauth2/logout", "auth": "Bearer {{ccToken}}", "assertions": ["status == 200"]}, {"name": "Gọi lại logout bằng token đã thu hồi → 401 (L4)", "endpointId": 47548479, "method": "GET", "path": "/oauth2/logout", "auth": "Bearer {{ccToken}}", "assertions": ["status == 401"]}]}
