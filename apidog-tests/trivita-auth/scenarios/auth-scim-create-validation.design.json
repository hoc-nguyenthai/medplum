{"slug": "auth-scim-create-validation", "name": "Auth | POST /scim/v2/Users: đầu vào (data-driven)", "priority": 2, "steps": [{"name": "Đăng nhập admin (email + mật khẩu)", "endpointId": 47548452, "method": "POST", "path": "/auth/login", "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}", "auth": "none", "assertions": ["status == 200", "$.code exists", "$.login exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "loginId", "expression": "$.login", "subject": "responseJson"}}, {"type": "extractor", "data": {"variableName": "code", "expression": "$.code", "subject": "responseJson"}}]}, {"name": "Đổi code lấy token (authorization_code)", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "authorization_code", "code": "{{code}}", "client_id": "{{clientId}}", "client_secret": "{{clientSecret}}"}, "assertions": ["status == 200", "$.access_token exists", "$.token_type == Bearer"], "postProcessors": [{"type": "extractor", "data": {"variableName": "userToken", "expression": "$.access_token", "subject": "responseJson"}}]}, {"name": "POST /scim/v2/Users theo dữ liệu", "endpointId": 47548486, "method": "POST", "path": "/scim/v2/Users", "body": "{{scim_body}}", "auth": "Bearer {{userToken}}", "assertions": ["status == {{expected_status}}"], "postProcessors": [{"type": "customScript", "data": {"script": "const c = pm.iterationData.get('expected_code'), m = pm.iterationData.get('expected_message'); let j = {}; try { j = pm.response.json(); } catch (e) {} if (c) { pm.test('scimType = ' + c, () => pm.expect(j.scimType).to.eql(c)); } if (m) { pm.test('detail = ' + m, () => pm.expect(j.detail).to.eql(m)); }"}}]}]}
