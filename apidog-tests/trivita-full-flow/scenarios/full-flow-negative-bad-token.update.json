       "subject": "responseJson"
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const k = pm.iterationData.get('bad_kind'); const m = {garbage: 'not-a-jwt', 'three-parts': 'aaa.bbb.ccc', sqli: \"' OR '1'='1\", 'bearer-word': 'Bearer', long: 'A'.repeat(4096),\n  'alg-none': ['eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0', 'eyJzdWIiOiJxYSJ9', ''].join('.')};\npm.variables.set('bad_token', m[k]);"
     }
    ],
