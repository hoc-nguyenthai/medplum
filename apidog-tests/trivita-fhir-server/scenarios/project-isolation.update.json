  {
   "id": "step-3",
   "number": 3,
   "name": "(A) POST Patient",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988323,
    "name": "(A) POST Patient",
    "path": "/fhir/R4/Patient",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "json",
     "data": "{\"resourceType\": \"Patient\", \"name\": [{\"family\": \"Iso-{{case_id}}-{{$timestamp}}\", \"given\": [\"Qa\"]}], \"gender\": \"male\"}"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 201",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "201"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.id exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$.id",
       "value": "",
       "extractSettings": {
        "expression": "$.id"
       }
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "patient_id",
       "expression": "$.id",
       "subject": "responseJson"
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "marker",
       "expression": "$.name[0].family",
       "subject": "responseJson"
      }
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{bearerToken}}"
     }
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
