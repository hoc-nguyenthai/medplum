{
 "slug": "code-system-import",
 "name": "CodeSystem/{id}/$import (lô nhỏ)",
 "priority": 2,
 "steps": [
  {
   "name": "Đăng nhập admin project (auth /auth/login)",
   "endpointId": "auth-login",
   "method": "POST",
   "path": "{{authUrl}}/auth/login",
   "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}",
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.code exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "adm_code",
      "expression": "$.code",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "Đổi code lấy token admin (authorization_code)",
   "endpointId": "auth-token",
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "form": {
    "grant_type": "authorization_code",
    "code": "{{adm_code}}",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "bearerToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "(setup) POST CodeSystem content=not-present",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/CodeSystem",
   "body": "{\"resourceType\": \"CodeSystem\", \"status\": \"active\", \"content\": \"not-present\", \"url\": \"http://qa.trivita.test/cs-import/{{case_id}}-{{$timestamp}}\"}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 201"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "cs_id",
      "expression": "$.id",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "POST CodeSystem/{id}/$import theo data",
   "endpointId": 47548508,
   "method": "POST",
   "path": "/fhir/R4/CodeSystem/{{cs_id}}/$import",
   "body": "{{import_body}}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == {{expected_status}}"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const code = pm.iterationData.get('expected_code'); const msg = pm.iterationData.get('expected_message'); let b = {}; try { b = pm.response.json(); } catch (x) {} const issue = (b.issue && b.issue[0]) || {}; const text = (issue.details && issue.details.text) || (b.errors && b.errors[0] && b.errors[0].message) || ''; if (code) { pm.test('issue.code == ' + code, () => pm.expect(issue.code).to.eql(code)); } if (msg) { pm.test('thông điệp chứa: ' + msg, () => pm.expect(text).to.include(msg)); }"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "POST $import lần hai cùng dữ liệu (idempotent với ca hợp lệ, cùng lỗi với ca sai)",
   "endpointId": 47548508,
   "method": "POST",
   "path": "/fhir/R4/CodeSystem/{{cs_id}}/$import",
   "body": "{{import_body}}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == {{expected_status}}"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const code = pm.iterationData.get('expected_code'); const msg = pm.iterationData.get('expected_message'); let b = {}; try { b = pm.response.json(); } catch (x) {} const issue = (b.issue && b.issue[0]) || {}; const text = (issue.details && issue.details.text) || (b.errors && b.errors[0] && b.errors[0].message) || ''; if (code) { pm.test('issue.code == ' + code, () => pm.expect(issue.code).to.eql(code)); } if (msg) { pm.test('thông điệp chứa: ' + msg, () => pm.expect(text).to.include(msg)); }"
     }
    }
   ],
   "custom": true
  }
 ]
}
