{
 "slug": "bulk-export-flow",
 "name": "Bulk export $export (async) đầu-cuối",
 "priority": 1,
 "steps": [
  {
   "name": "Đăng nhập admin project (auth /auth/login)",
   "endpointId": "auth-login",
   "method": "POST",
   "path": "{{authUrl}}/auth/login",
   "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}",
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.code exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "adm_code",
      "expression": "$.code",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "Đổi code lấy token admin (authorization_code)",
   "endpointId": "auth-token",
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "form": {
    "grant_type": "authorization_code",
    "code": "{{adm_code}}",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "bearerToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "(setup) POST Patient (đảm bảo có dữ liệu)",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/Patient",
   "body": "{\"resourceType\": \"Patient\", \"name\": [{\"family\": \"Bx-{{$timestamp}}\", \"given\": [\"Qa\"]}]}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 201",
    "$.id exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "patient_id",
      "expression": "$.id",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "GET $export (Prefer: respond-async)",
   "endpointId": 47548504,
   "method": "GET",
   "path": "/fhir/R4/$export",
   "query": {
    "_type": "Patient",
    "_outputFormat": "ndjson"
   },
   "headers": {
    "Prefer": "respond-async"
   },
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 202",
    "$.resourceType == OperationOutcome"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const loc = pm.response.headers.get('Content-Location') || ''; const m = loc.match(/bulkdata\\/([^\\/]+)\\/status/); pm.test('Content-Location có id job', () => pm.expect(m).to.not.eql(null)); if (m) { pm.variables.set('job_id', m[1]); }"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "GET bulkdata/{id}/status (lần 1)",
   "endpointId": 47548505,
   "method": "GET",
   "path": "/fhir/R4/bulkdata/{{job_id}}/status",
   "auth": "Bearer {{bearerToken}}",
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('202 hoặc 200', () => pm.expect([200, 202]).to.include(pm.response.code));"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const t0 = Date.now(); while (Date.now() - t0 < 3000) {}"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "GET bulkdata/{id}/status (lần 2)",
   "endpointId": 47548505,
   "method": "GET",
   "path": "/fhir/R4/bulkdata/{{job_id}}/status",
   "auth": "Bearer {{bearerToken}}",
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('202 hoặc 200', () => pm.expect([200, 202]).to.include(pm.response.code));"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const t0 = Date.now(); while (Date.now() - t0 < 3000) {}"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "GET bulkdata/{id}/status (lần 3)",
   "endpointId": 47548505,
   "method": "GET",
   "path": "/fhir/R4/bulkdata/{{job_id}}/status",
   "auth": "Bearer {{bearerToken}}",
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('202 hoặc 200', () => pm.expect([200, 202]).to.include(pm.response.code));"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const t0 = Date.now(); while (Date.now() - t0 < 3000) {}"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "GET bulkdata/{id}/status → 200 manifest",
   "endpointId": 47548505,
   "method": "GET",
   "path": "/fhir/R4/bulkdata/{{job_id}}/status",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200",
    "$.requiresAccessToken == true",
    "$.output is array"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const u = (pm.response.json().output || [])[0]; pm.test('có file output', () => pm.expect(u).to.not.eql(undefined)); if (u) { pm.variables.set('bin_id', String(u.url).split('/').pop()); }"
     }
    }
   ]
  },
  {
   "name": "GET Binary/{id} (ndjson)",
   "endpointId": 47548498,
   "method": "GET",
   "path": "/fhir/R4/Binary/{{bin_id}}",
   "headers": {
    "Accept": "application/fhir+ndjson"
   },
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('ndjson chứa Patient', () => pm.expect(pm.response.text()).to.include('\"resourceType\":\"Patient\"'));"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "DELETE bulkdata/{id}/status → 202",
   "endpointId": 47548506,
   "method": "DELETE",
   "path": "/fhir/R4/bulkdata/{{job_id}}/status",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 202"
   ],
   "custom": true
  },
  {
   "name": "GET status sau xóa → 404/410",
   "endpointId": 47548505,
   "method": "GET",
   "path": "/fhir/R4/bulkdata/{{job_id}}/status",
   "auth": "Bearer {{bearerToken}}",
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('404 hoặc 410', () => pm.expect([404, 410]).to.include(pm.response.code));"
     }
    }
   ],
   "custom": true
  }
 ]
}
