   "name": "Đăng ký kênh websocket (JSON)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988443,
    "name": "Đăng ký kênh websocket (JSON)",
    "path": "/fhircast/STU3",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "json",
     "data": "{\"hub.channel.type\":\"websocket\",\"hub.mode\":\"subscribe\",\"hub.topic\":\"{{topic}}\",\"hub.events\":\"syncerror,heartbeat,userlogout,userhibernate,Patient-open,Patient-close,ImagingStudy-open,ImagingStudy-close,Encounter-open,Encounter-close,DiagnosticReport-open,DiagnosticReport-close,DiagnosticReport-select,DiagnosticReport-update\"}"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 202",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "202"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$['hub.channel.endpoint'] exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$['hub.channel.endpoint']",
       "value": "",
       "extractSettings": {
        "expression": "$['hub.channel.endpoint']"
       }
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "channel_endpoint",
       "expression": "$['hub.channel.endpoint']",
       "subject": "responseJson"
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "if (pm.response.code === 202) { pm.test('hub.channel.endpoint', () => pm.expect(pm.response.json()['hub.channel.endpoint']).to.match(/\\/ws\\/fhircast\\/[0-9a-f-]{36}$/)); }"
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{access_token}}"
     }
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
