{
 "slug": "terminology-expand",
 "name": "ValueSet/$expand",
 "priority": 1,
 "steps": [
  {
   "name": "Đăng nhập admin project (auth /auth/login)",
   "endpointId": "auth-login",
   "method": "POST",
   "path": "{{authUrl}}/auth/login",
   "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}",
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.code exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "adm_code",
      "expression": "$.code",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "Đổi code lấy token admin (authorization_code)",
   "endpointId": "auth-token",
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "form": {
    "grant_type": "authorization_code",
    "code": "{{adm_code}}",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "bearerToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "(setup) POST CodeSystem (A > A1, B)",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/CodeSystem",
   "body": "{\"resourceType\": \"CodeSystem\", \"status\": \"active\", \"content\": \"complete\", \"url\": \"http://qa.trivita.test/cs/{{case_id}}-{{$timestamp}}\", \"concept\": [{\"code\": \"A\", \"display\": \"Alpha\", \"concept\": [{\"code\": \"A1\", \"display\": \"Alpha one\"}]}, {\"code\": \"B\", \"display\": \"Beta\"}]}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 201"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "cs_url",
      "expression": "$.url",
      "subject": "responseJson"
     }
    },
    {
     "type": "extractor",
     "data": {
      "variableName": "cs_id",
      "expression": "$.id",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "(setup) POST ValueSet include CodeSystem",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/ValueSet",
   "body": "{\"resourceType\": \"ValueSet\", \"status\": \"active\", \"url\": \"http://qa.trivita.test/vs/{{case_id}}-{{$timestamp}}\", \"compose\": {\"include\": [{\"system\": \"{{cs_url}}\"}]}}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 201"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "vs_url",
      "expression": "$.url",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "GET ValueSet/$expand theo data",
   "endpointId": 47548520,
   "method": "GET",
   "path": "/fhir/R4/ValueSet/$expand",
   "query": {
    "{{url_name}}": "{{vs_url}}{{url_suffix}}",
    "{{count_name}}": "{{count_value}}",
    "{{offset_name}}": "{{offset_value}}"
   },
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == {{expected_status}}"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const code = pm.iterationData.get('expected_code'); const msg = pm.iterationData.get('expected_message'); let b = {}; try { b = pm.response.json(); } catch (x) {} const issue = (b.issue && b.issue[0]) || {}; const text = (issue.details && issue.details.text) || (b.errors && b.errors[0] && b.errors[0].message) || ''; if (code) { pm.test('issue.code == ' + code, () => pm.expect(issue.code).to.eql(code)); } if (msg) { pm.test('thông điệp chứa: ' + msg, () => pm.expect(text).to.include(msg)); }"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const g = k => pm.iterationData.get(k); const b = pm.response.json(); if (g('expected_total')) { pm.test('expansion.total == ' + g('expected_total'), () => pm.expect(b.expansion.total).to.eql(Number(g('expected_total')))); } if (g('expected_contains')) { pm.test('contains == ' + g('expected_contains'), () => pm.expect((b.expansion.contains || []).length).to.eql(Number(g('expected_contains')))); }"
     }
    }
   ],
   "custom": true
  }
 ]
}
