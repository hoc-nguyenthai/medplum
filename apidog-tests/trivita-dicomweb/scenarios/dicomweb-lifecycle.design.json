{
 "slug": "dicomweb-lifecycle",
 "name": "DICOMweb: lifecycle STOW → QIDO → WADO",
 "priority": 0,
 "steps": [
  {
   "name": "Lấy access token (client_credentials của auth)",
   "endpointId": 9000001,
   "path": "{{authUrl}}/oauth2/token",
   "auth": "none",
   "custom": true,
   "form": {
    "grant_type": "client_credentials",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const tok = pm.response.json().access_token; pm.variables.set('accessToken', tok);\ntry { const p = JSON.parse(atob(tok.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))); pm.variables.set('projectId', p.fhir_project || ''); } catch (e) { pm.variables.set('projectId', ''); }\nconst base = '1.2.826.0.1.3680043.9.7777.' + Date.now() + (100 + Math.floor(Math.random() * 900));\npm.variables.set('studyUid', base + '.1'); pm.variables.set('seriesUid', base + '.1.1'); pm.variables.set('sop1', base + '.1.1.1'); pm.variables.set('sop2', base + '.1.1.2');\npm.variables.set('series2Uid', base + '.1.2'); pm.variables.set('sop3', base + '.1.2.1'); pm.variables.set('otherStudyUid', base + '.9');\npm.variables.set('pid', 'QA-' + Date.now());"
     }
    }
   ]
  },
  {
   "name": "STOW-RS dạng metadata: 2 instance cùng study/series (200)",
   "endpointId": 47548526,
   "path": "/dicomweb/studies",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "method": "post",
   "headers": {
    "Content-Type": "multipart/related; type=\"application/dicom+json\"; boundary=qa-bnd"
   },
   "body": "--qa-bnd\r\nContent-Type: application/dicom+json\r\n\r\n[{\"00080016\":{\"vr\":\"UI\",\"Value\":[\"1.2.840.10008.5.1.4.1.1.2\"]},\"00080018\":{\"vr\":\"UI\",\"Value\":[\"{{sop1}}\"]},\"00080060\":{\"vr\":\"CS\",\"Value\":[\"CT\"]},\"00080020\":{\"vr\":\"DA\",\"Value\":[\"20240102\"]},\"00100010\":{\"vr\":\"PN\",\"Value\":[{\"Alphabetic\":\"Qa^Lifecycle\"}]},\"00100020\":{\"vr\":\"LO\",\"Value\":[\"{{pid}}\"]},\"0020000D\":{\"vr\":\"UI\",\"Value\":[\"{{studyUid}}\"]},\"0020000E\":{\"vr\":\"UI\",\"Value\":[\"{{seriesUid}}\"]},\"00080050\":{\"vr\":\"SH\",\"Value\":[\"ACC-LIFE\"]},\"00280002\":{\"vr\":\"US\",\"Value\":[1]},\"00280004\":{\"vr\":\"CS\",\"Value\":[\"MONOCHROME2\"]},\"00280008\":{\"vr\":\"IS\",\"Value\":[\"{{frames}}\"]},\"00280010\":{\"vr\":\"US\",\"Value\":[{{rows}}]},\"00280011\":{\"vr\":\"US\",\"Value\":[{{rows}}]},\"00280100\":{\"vr\":\"US\",\"Value\":[8]},\"00280101\":{\"vr\":\"US\",\"Value\":[8]},\"00280102\":{\"vr\":\"US\",\"Value\":[7]},\"00280103\":{\"vr\":\"US\",\"Value\":[0]},\"7FE00010\":{\"vr\":\"OB\",\"BulkDataURI\":\"urn:qa:px1\"}},{\"00080016\":{\"vr\":\"UI\",\"Value\":[\"1.2.840.10008.5.1.4.1.1.2\"]},\"00080018\":{\"vr\":\"UI\",\"Value\":[\"{{sop2}}\"]},\"00080060\":{\"vr\":\"CS\",\"Value\":[\"CT\"]},\"00080020\":{\"vr\":\"DA\",\"Value\":[\"20240102\"]},\"00100010\":{\"vr\":\"PN\",\"Value\":[{\"Alphabetic\":\"Qa^Lifecycle\"}]},\"00100020\":{\"vr\":\"LO\",\"Value\":[\"{{pid}}\"]},\"0020000D\":{\"vr\":\"UI\",\"Value\":[\"{{studyUid}}\"]},\"0020000E\":{\"vr\":\"UI\",\"Value\":[\"{{seriesUid}}\"]},\"00280002\":{\"vr\":\"US\",\"Value\":[1]},\"00280004\":{\"vr\":\"CS\",\"Value\":[\"MONOCHROME2\"]},\"00280008\":{\"vr\":\"IS\",\"Value\":[\"1\"]},\"00280010\":{\"vr\":\"US\",\"Value\":[{{rows}}]},\"00280011\":{\"vr\":\"US\",\"Value\":[{{rows}}]},\"00280100\":{\"vr\":\"US\",\"Value\":[8]},\"00280101\":{\"vr\":\"US\",\"Value\":[8]},\"00280102\":{\"vr\":\"US\",\"Value\":[7]},\"00280103\":{\"vr\":\"US\",\"Value\":[0]},\"7FE00010\":{\"vr\":\"OB\",\"BulkDataURI\":\"urn:qa:px2\"}}]\r\n--qa-bnd\r\nContent-Location: urn:qa:px1\r\nContent-Type: application/octet-stream\r\n\r\n{{px}}\r\n--qa-bnd\r\nContent-Location: urn:qa:px2\r\nContent-Type: application/octet-stream\r\n\r\n{{f1}}\r\n--qa-bnd--\r\n",
   "bodyType": "raw",
   "assertions": [
    "status == 200"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"Content-Type dicom+json\", () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/dicom+json'); });"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"ReferencedSOPSequence có 2 phần tử, không có FailedSOPSequence\", () => { const j = pm.response.json(); pm.expect(j['00081199'].Value.length).to.eql(2); pm.expect(j['00081198']).to.eql(undefined); });"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"RetrieveURL cấp study trỏ đúng studyUid\", () => { pm.expect(pm.response.json()['00081190'].Value[0]).to.include(pm.variables.get('studyUid')); });"
     }
    }
   ]
  },
  {
