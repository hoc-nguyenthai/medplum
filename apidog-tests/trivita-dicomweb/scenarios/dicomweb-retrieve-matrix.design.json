{
 "slug": "dicomweb-retrieve-matrix",
 "name": "DICOMweb: WADO-RS / WADO-URI / QIDO cấp con (data-driven)",
 "priority": 1,
 "steps": [
  {
   "name": "Lấy access token (client_credentials của auth)",
   "endpointId": 9000001,
   "path": "{{authUrl}}/oauth2/token",
   "auth": "none",
   "custom": true,
   "form": {
    "grant_type": "client_credentials",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const tok = pm.response.json().access_token; pm.variables.set('accessToken', tok);\ntry { const p = JSON.parse(atob(tok.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))); pm.variables.set('projectId', p.fhir_project || ''); } catch (e) { pm.variables.set('projectId', ''); }\nconst base = '1.2.826.0.1.3680043.9.7777.' + Date.now() + (100 + Math.floor(Math.random() * 900));\npm.variables.set('studyUid', base + '.1'); pm.variables.set('seriesUid', base + '.1.1'); pm.variables.set('sop1', base + '.1.1.1'); pm.variables.set('sop2', base + '.1.1.2');\npm.variables.set('series2Uid', base + '.1.2'); pm.variables.set('sop3', base + '.1.2.1'); pm.variables.set('otherStudyUid', base + '.9');\npm.variables.set('pid', 'QA-' + Date.now());"
     }
    }
   ]
  },
  {
   "name": "Seed: STOW study cố định",
   "endpointId": 47548526,
   "path": "/dicomweb/studies",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "method": "post",
   "headers": {
    "Content-Type": "multipart/related; type=\"application/dicom+json\"; boundary=qa-bnd"
   },
   "body": "--qa-bnd\r\nContent-Type: application/dicom+json\r\n\r\n[{\"00080016\":{\"vr\":\"UI\",\"Value\":[\"1.2.840.10008.5.1.4.1.1.2\"]},\"00080018\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.200.1.1.1\"]},\"00080060\":{\"vr\":\"CS\",\"Value\":[\"CT\"]},\"00080020\":{\"vr\":\"DA\",\"Value\":[\"20240102\"]},\"00100010\":{\"vr\":\"PN\",\"Value\":[{\"Alphabetic\":\"Qa^Retrieve\"}]},\"00100020\":{\"vr\":\"LO\",\"Value\":[\"QA-RETRIEVE\"]},\"0020000D\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.200.1\"]},\"0020000E\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.200.1.1\"]},\"00280002\":{\"vr\":\"US\",\"Value\":[1]},\"00280004\":{\"vr\":\"CS\",\"Value\":[\"MONOCHROME2\"]},\"00280008\":{\"vr\":\"IS\",\"Value\":[\"3\"]},\"00280010\":{\"vr\":\"US\",\"Value\":[2]},\"00280011\":{\"vr\":\"US\",\"Value\":[2]},\"00280100\":{\"vr\":\"US\",\"Value\":[8]},\"00280101\":{\"vr\":\"US\",\"Value\":[8]},\"00280102\":{\"vr\":\"US\",\"Value\":[7]},\"00280103\":{\"vr\":\"US\",\"Value\":[0]},\"7FE00010\":{\"vr\":\"OB\",\"BulkDataURI\":\"urn:qa:rm\"}},{\"00080016\":{\"vr\":\"UI\",\"Value\":[\"1.2.840.10008.5.1.4.1.1.88.11\"]},\"00080018\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.200.1.2.1\"]},\"00080060\":{\"vr\":\"CS\",\"Value\":[\"SR\"]},\"00080020\":{\"vr\":\"DA\",\"Value\":[\"20240102\"]},\"00100010\":{\"vr\":\"PN\",\"Value\":[{\"Alphabetic\":\"Qa^Retrieve\"}]},\"00100020\":{\"vr\":\"LO\",\"Value\":[\"QA-RETRIEVE\"]},\"0020000D\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.200.1\"]},\"0020000E\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.200.1.2\"]}}]\r\n--qa-bnd\r\nContent-Location: urn:qa:rm\r\nContent-Type: application/octet-stream\r\n\r\nABCDEFGHIJKL\r\n--qa-bnd--\r\n",
   "bodyType": "raw",
   "assertions": [
    "status == 200"
   ]
  },
  {
   "name": "GET theo dữ liệu",
   "endpointId": 9000002,
   "path": "{{dicomUrl}}{{req_path}}",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "headers": {
    "Accept": "{{accept}}"
   },
   "assertions": [
    "status == {{expected_status}}"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const m = pm.iterationData.get('expected_message'); if (m) { pm.test('error = ' + m, () => pm.expect(pm.response.json().error).to.eql(m)); }"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const c = pm.iterationData.get('expected_ct'); if (c) { pm.test('Content-Type chứa ' + c, () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include(c)); }"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const b = pm.iterationData.get('expect_body'); if (b) { pm.test('body chứa ' + b, () => pm.expect(pm.response.text()).to.include(b)); }"
     }
    }
   ]
  }
 ]
}
