{
 "steps": [
  {
   "id": "step-1",
   "number": 1,
   "name": "Đăng nhập admin project (auth /auth/login)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988331,
    "name": "Đăng nhập admin project (auth /auth/login)",
    "path": "{{authUrl}}/auth/login",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "json",
     "data": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.code exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$.code",
       "value": "",
       "extractSettings": {
        "expression": "$.code"
       }
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "adm_code",
       "expression": "$.code",
       "subject": "responseJson"
      }
     }
    ],
    "auth": {
     "type": "noauth"
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988331
  },
  {
   "id": "step-2",
   "number": 2,
   "name": "Đổi code lấy token admin (authorization_code)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988499,
    "name": "Đổi code lấy token admin (authorization_code)",
    "path": "{{authUrl}}/oauth2/token",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "x-www-form-urlencoded",
     "parameters": [
      {
       "name": "grant_type",
       "value": "authorization_code",
       "enable": true,
       "type": "string"
      },
      {
       "name": "code",
       "value": "{{adm_code}}",
       "enable": true,
       "type": "string"
      },
      {
       "name": "client_id",
       "value": "{{clientId}}",
       "enable": true,
       "type": "string"
      },
      {
       "name": "client_secret",
       "value": "{{clientSecret}}",
       "enable": true,
       "type": "string"
      }
     ]
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.access_token exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$.access_token",
       "value": "",
       "extractSettings": {
        "expression": "$.access_token"
       }
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "bearerToken",
       "expression": "$.access_token",
       "subject": "responseJson"
      }
     }
    ],
    "auth": {
     "type": "noauth"
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988499
  },
  {
   "id": "step-3",
   "number": 3,
   "name": "GET Project/{projectId}/$rate-limits",
   "type": "http",
   "bindType": "API",
   "syncMode": "MANUAL",
   "bindId": 47548513,
   "httpApiCase": {
    "type": "DEBUG_CASE",
    "name": "GET Project/{projectId}/$rate-limits",
    "path": "/fhir/R4/Project/{id}/$rate-limits",
    "method": "get",
    "apiDetailId": 47548513,
    "projectId": 1380475,
    "parameters": {
     "path": [
      {
       "name": "id",
       "value": "{{projectId}}",
       "enable": true
      }
     ],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "none"
    },
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.resourceType == Parameters",
       "subject": "responseJson",
       "comparison": "equal",
       "path": "$.resourceType",
       "value": "Parameters",
       "extractSettings": {
        "expression": "$.resourceType"
       }
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const p = pm.response.json().parameter.find(x => x.name === 'enabled'); pm.test('có tham số enabled', () => pm.expect(p).to.not.eql(undefined));"
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{bearerToken}}"
     }
    },
    "id": 65413403
   },
   "relatedId": 65413403
  },
  {
   "id": "step-4",
   "number": 4,
   "name": "GET Project/khac/$rate-limits → 403",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988329,
    "name": "GET Project/khac/$rate-limits → 403",
    "path": "/fhir/R4/Project/project-khac/$rate-limits",
    "method": "get",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "none"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 403",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "403"
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "pm.test('thông điệp', () => pm.expect(pm.response.json().issue[0].details.text).to.include('Chỉ quản trị của chính project này được xem hạn mức'));"
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{bearerToken}}"
     }
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988329
  },
  {
