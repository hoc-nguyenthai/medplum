      {
       "name": "Content-Type",
       "value": "multipart/related; type=\"application/dicom+json\"; boundary=qa-bnd",
       "enable": true
      }
     ],
     "cookie": []
    },
    "requestBody": {
     "type": "raw",
     "data": "--qa-bnd\r\nContent-Type: application/dicom+json\r\n\r\n[{\"00080016\":{\"vr\":\"UI\",\"Value\":[\"1.2.840.10008.5.1.4.1.1.2\"]},\"00080018\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.300.1.1.1\"]},\"00080060\":{\"vr\":\"CS\",\"Value\":[\"CT\"]},\"00080020\":{\"vr\":\"DA\",\"Value\":[\"20240102\"]},\"00100010\":{\"vr\":\"PN\",\"Value\":[{\"Alphabetic\":\"Qa^Alpha\"}]},\"00100020\":{\"vr\":\"LO\",\"Value\":[\"QA-QIDO-1\"]},\"0020000D\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.300.1\"]},\"0020000E\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.300.1.1\"]},\"00080050\":{\"vr\":\"SH\",\"Value\":[\"ACC-1\"]},\"00280002\":{\"vr\":\"US\",\"Value\":[1]},\"00280004\":{\"vr\":\"CS\",\"Value\":[\"MONOCHROME2\"]},\"00280008\":{\"vr\":\"IS\",\"Value\":[\"1\"]},\"00280010\":{\"vr\":\"US\",\"Value\":[2]},\"00280011\":{\"vr\":\"US\",\"Value\":[2]},\"00280100\":{\"vr\":\"US\",\"Value\":[8]},\"00280101\":{\"vr\":\"US\",\"Value\":[8]},\"00280102\":{\"vr\":\"US\",\"Value\":[7]},\"00280103\":{\"vr\":\"US\",\"Value\":[0]},\"7FE00010\":{\"vr\":\"OB\",\"BulkDataURI\":\"urn:qa:q1\"}},{\"00080016\":{\"vr\":\"UI\",\"Value\":[\"1.2.840.10008.5.1.4.1.1.2\"]},\"00080018\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.300.2.1.1\"]},\"00080060\":{\"vr\":\"CS\",\"Value\":[\"MR\"]},\"00080020\":{\"vr\":\"DA\",\"Value\":[\"20240215\"]},\"00100010\":{\"vr\":\"PN\",\"Value\":[{\"Alphabetic\":\"Qa^Beta\"}]},\"00100020\":{\"vr\":\"LO\",\"Value\":[\"QA-QIDO-2\"]},\"0020000D\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.300.2\"]},\"0020000E\":{\"vr\":\"UI\",\"Value\":[\"1.2.826.0.1.3680043.9.7777.300.2.1\"]},\"00080050\":{\"vr\":\"SH\",\"Value\":[\"ACC-2\"]},\"00280002\":{\"vr\":\"US\",\"Value\":[1]},\"00280004\":{\"vr\":\"CS\",\"Value\":[\"MONOCHROME2\"]},\"00280008\":{\"vr\":\"IS\",\"Value\":[\"1\"]},\"00280010\":{\"vr\":\"US\",\"Value\":[2]},\"00280011\":{\"vr\":\"US\",\"Value\":[2]},\"00280100\":{\"vr\":\"US\",\"Value\":[8]},\"00280101\":{\"vr\":\"US\",\"Value\":[8]},\"00280102\":{\"vr\":\"US\",\"Value\":[7]},\"00280103\":{\"vr\":\"US\",\"Value\":[0]},\"7FE00010\":{\"vr\":\"OB\",\"BulkDataURI\":\"urn:qa:q2\"}}]\r\n--qa-bnd\r\nContent-Location: urn:qa:q1\r\nContent-Type: application/octet-stream\r\n\r\nABCD\r\n--qa-bnd\r\nContent-Location: urn:qa:q2\r\nContent-Type: application/octet-stream\r\n\r\nEFGH\r\n--qa-bnd--\r\n"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{accessToken}}"
     }
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988178
  },
  {
   "id": "step-3",
   "number": 3,
   "name": "QIDO /studies theo dữ liệu",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988177,
    "name": "QIDO /studies theo dữ liệu",
    "path": "/dicomweb/studies?PatientID={{PatientID}}&PatientName={{PatientName}}&StudyDate={{StudyDate}}&ModalitiesInStudy={{ModalitiesInStudy}}&AccessionNumber={{AccessionNumber}}&limit={{limit}}&offset={{offset}}&00100020={{tag_hex}}",
    "method": "get",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "none"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == {{expected_status}}",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "{{expected_status}}"
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const m = pm.iterationData.get('expected_message'); if (m) { pm.test('error = ' + m, () => pm.expect(pm.response.json().error).to.eql(m)); }"
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const n = pm.iterationData.get('expected_count'); if (n !== '' && n !== undefined && pm.response.code === 200) { pm.test('số kết quả = ' + n, () => pm.expect(pm.response.json().length).to.eql(parseInt(n))); }"
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const w = pm.iterationData.get('expect_warning'); const h = pm.response.headers.get('Warning') || ''; if (w === 'more') { pm.test('Warning: còn trang sau', () => pm.expect(h).to.include('additional results')); } if (w === 'none') { pm.test('không Warning trang sau', () => pm.expect(h).to.not.include('additional results')); }"
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{accessToken}}"
     }
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988177
  }
 ]
}
