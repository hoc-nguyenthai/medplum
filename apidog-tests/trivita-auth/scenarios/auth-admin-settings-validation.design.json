{"slug": "auth-admin-settings-validation", "name": "Auth | POST /admin/projects/{id}/settings: allowlist và giá trị (data-driven)", "priority": 1, "steps": [{"name": "Đăng nhập admin (email + mật khẩu)", "endpointId": 47548452, "method": "POST", "path": "/auth/login", "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}", "auth": "none", "assertions": ["status == 200", "$.code exists", "$.login exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "loginId", "expression": "$.login", "subject": "responseJson"}}, {"type": "extractor", "data": {"variableName": "code", "expression": "$.code", "subject": "responseJson"}}]}, {"name": "Đổi code lấy token (authorization_code)", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "authorization_code", "code": "{{code}}", "client_id": "{{clientId}}", "client_secret": "{{clientSecret}}"}, "assertions": ["status == 200", "$.access_token exists", "$.token_type == Bearer"], "postProcessors": [{"type": "extractor", "data": {"variableName": "userToken", "expression": "$.access_token", "subject": "responseJson"}}]}, {"name": "Đặt settings theo dữ liệu", "endpointId": 47548439, "method": "POST", "path": "/admin/projects/{{projectId}}/settings", "body": "{{admin_body}}", "auth": "Bearer {{userToken}}", "assertions": ["status == {{expected_status}}"], "postProcessors": [{"type": "customScript", "data": {"script": "const c = pm.iterationData.get('expected_code'), m = pm.iterationData.get('expected_message'); let j = {}; try { j = pm.response.json(); } catch (e) {} const is = j.issue || []; if (c) { pm.test('issue code = ' + c, () => pm.expect(is.length ? is[0].code : '').to.eql(c)); } if (m) { pm.test('details.text = ' + m, () => pm.expect(is.map(i => (i.details || {}).text)).to.include(m)); }"}}]}]}
