# Mẫu cấu hình dicomweb (docs/config.md liệt kê đủ ý nghĩa). Sao chép thành .env để chạy local (`make run-dicomweb`); biến môi trường thật luôn thắng .env.
# Dùng chung một tệp môi trường với fhir-server được: các biến DATABASE_*, FHIR_JWT_*, FHIR_BINARY_STORAGE, FHIR_S3_* cùng tên.

# ---- Chung ----
# APP_NAME=trivita-dicomweb
# HTTP_ADDR=:8008
# DEBUG=false
# ENVIRONMENT=local              # local | development | staging | production (staging/production siết ràng buộc)
# READINESS_TIMEOUT=2s
# SHUTDOWN_DRAIN_DELAY=5s
# SHUTDOWN_TIMEOUT=25s
# READ_HEADER_TIMEOUT=10s
# DICOMWEB_BASE_URL=http://localhost:8008   # địa chỉ công khai, dùng cho RetrieveURL

# ---- Cơ sở dữ liệu: CÙNG schema fhir với fhir-server (dicomweb không migrate; chạy `fhir-server migrate up` trước) ----
# DATABASE_URL=sqlite://./fhir.db
# DATABASE_ECHO=false
# DATABASE_REQUIRE_SCHEMA=false
# DATABASE_MAX_OPEN_CONNS=20
# DATABASE_MAX_IDLE_CONNS=5
# DATABASE_CONN_MAX_LIFETIME=30m

# ---- JWT do auth cấp (bắt buộc) ----
FHIR_JWT_ISSUER=http://localhost:8006
FHIR_JWT_AUDIENCE=http://localhost:8006
FHIR_JWKS_URL=http://localhost:8006/.well-known/jwks.json
# FHIR_JWT_HMAC_SECRET=          # chỉ dev/test, thay cho FHIR_JWKS_URL (tối thiểu 32 ký tự)
# FHIR_JWT_PROJECT_CLAIM=fhir_project
# FHIR_JWT_SCOPE_CLAIM=scope
# FHIR_JWT_POLICY_CLAIM=fhir_access_policy
# FHIR_JWT_SUPER_ADMIN=false

# ---- Kho nội dung DICOM (bắt buộc, trùng FHIR_BINARY_STORAGE của fhir-server) ----
FHIR_BINARY_STORAGE=file:./storage
# FHIR_S3_REGION=
# FHIR_S3_ENDPOINT=
# FHIR_S3_ACCESS_KEY_ID=
# FHIR_S3_SECRET_ACCESS_KEY=
# FHIR_S3_SESSION_TOKEN=
# FHIR_S3_SSE=

# ---- Giới hạn tải lên ----
# DICOMWEB_MAX_INSTANCE_BYTES=1073741824    # một instance (1 GiB)
# DICOMWEB_MAX_REQUEST_BYTES=4294967296     # cả yêu cầu STOW (4 GiB)
# DICOMWEB_MAX_HEADER_BYTES=1048576         # phần đầu trước PixelData (1 MiB)

# ---- Mạng ----
# DICOMWEB_ALLOWED_ORIGINS=http://localhost:3000   # mặc định ở local
# DICOMWEB_TRUSTED_PROXIES=
# DICOMWEB_RATE_LIMIT=0          # không đặt: tắt ở local, 20 ở staging/production
# DICOMWEB_RATE_BURST=0
