# Cấu hình nằm ở apps/ws-gateway/.env (một nơi duy nhất, dùng chung cho chạy local và compose).
# Chạy local:  make run-ws-gateway        (đọc .env ở apps/ws-gateway, biến môi trường thật thắng .env)
# Docker:      docker compose --env-file apps/ws-gateway/.env up --build ws-gateway redis

HTTP_ADDR=:8007
# local | development | staging | production. staging/production: REDIS_URL phải đặt tường minh, cấm FHIR_WS_ALLOWED_ORIGINS=*.
ENVIRONMENT=local

# Redis dùng chung với fhir-server: kênh sự kiện của Subscription và sổ hiện diện.
REDIS_URL=redis://localhost:6379/0

# Khóa HMAC xác minh token bind do fhir-server cấp: PHẢI GIỐNG HỆT FHIR_WS_SIGNING_KEY của fhir-server (>= 32 ký tự).
# `openssl rand -base64 48`
FHIR_WS_SIGNING_KEY=thay-bang-khoa-ngau-nhien-dai-it-nhat-32-ky-tu
# Khóa cũ (chỉ để xác minh) trong lúc xoay khóa, cách nhau bằng dấu phẩy, tối đa 3. Đặt khóa mới ở gateway TRƯỚC, đổi bên cấp sau.
# FHIR_WS_SIGNING_KEY_PREVIOUS=

# ---- Giới hạn (mỗi instance) ----
# FHIR_WS_MAX_CONNECTIONS=1000
# FHIR_WS_MAX_BINDINGS_PER_USER=20
# Kết nối tối đa từ một IP (0 = tắt). Sau proxy PHẢI đặt FHIR_WS_TRUSTED_PROXIES, nếu không mọi kết nối cùng IP của proxy.
# FHIR_WS_MAX_CONNS_PER_IP=50
# FHIR_WS_TRUSTED_PROXIES=10.0.0.0/8
# Số lần mở websocket mỗi giây mỗi IP (không đặt: staging/production 10, còn lại tắt).
# FHIR_WS_RATE_LIMIT=10

# Mẫu HOST của Origin được phép (không phải URL), cách nhau bằng dấu phẩy. Rỗng: chỉ cùng host.
# FHIR_WS_ALLOWED_ORIGINS=app.example.org,*.example.org

# ---- Thời gian ----
# FHIR_WS_HEARTBEAT=30s
# FHIR_WS_CLOSE_TIMEOUT=5s
# Bên phát ngừng gửi sau thời gian này nếu gateway chết im lặng (gateway gia hạn mỗi TTL/3).
# FHIR_WS_PRESENCE_TTL=30s
# SHUTDOWN_DRAIN_DELAY=5s
# SHUTDOWN_TIMEOUT=25s

# ---- FHIRcast (tắt mặc định) ----
# Hub FHIRcast ở /fhircast/STU2, /fhircast/STU3 và /hub (bí danh STU3). Dùng Redis ở trên (đăng ký, ngữ cảnh, kênh sự kiện).
# Xác thực bằng JWT của auth (phải có claim project và scope fhircast/*). Kênh websocket /ws/fhircast/{endpoint} dùng chung Origin, giới hạn IP và hạn mức tốc độ ở trên.
# FHIRCAST_ENABLED=true
# Địa chỉ WebSocket CÔNG KHAI của gateway, dùng dựng hub.channel.endpoint (không suy từ header Host). wss:// ở staging/production.
# FHIRCAST_PUBLIC_URL=wss://ws.example.org
# FHIRCAST_JWT_ISSUER=https://auth.example.org
# FHIRCAST_JWT_AUDIENCE=fhir
# FHIRCAST_JWKS_URL=https://auth.example.org/.well-known/jwks.json
# CHỈ cho dev/test (HS256, >= 32 ký tự), cấm ở staging/production; đặt đúng một trong JWKS và HMAC.
# FHIRCAST_JWT_HMAC_SECRET=
# Đòi scope fhircast/* (mặc định true; tắt chỉ để chuyển tiếp, cấm ở staging/production).
# FHIRCAST_REQUIRE_SCOPE=true
# POST /{topic} mà event["hub.topic"] khác topic ở đường dẫn: mặc định từ chối 400 "Topic mismatch"; true = như Medplum (bỏ qua topic đường dẫn).
# FHIRCAST_ALLOW_TOPIC_MISMATCH=false
# FHIRCAST_LEASE=1h
# FHIRCAST_CONTEXT_TTL=24h
# FHIRCAST_MAX_CONTEXT_BYTES=262144
# FHIRCAST_MAX_UPDATE_ENTRIES=200
# FHIRCAST_MAX_BODY_BYTES=1048576
# Kênh websocket FHIRcast (mỗi instance): số socket tối đa, số socket đồng thời của MỘT endpoint, chu kỳ heartbeat từng socket.
# FHIRCAST_MAX_CONNECTIONS=1000
# FHIRCAST_MAX_SOCKETS_PER_ENDPOINT=4
# FHIRCAST_HEARTBEAT=10s
