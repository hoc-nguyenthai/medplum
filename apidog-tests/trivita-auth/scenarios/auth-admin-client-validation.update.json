{
 "steps": [
  {
   "id": "step-1",
   "number": 1,
   "name": "Đăng nhập admin (email + mật khẩu)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988406,
    "name": "Đăng nhập admin (email + mật khẩu)",
    "path": "/auth/login",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "json",
     "data": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.code exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$.code",
       "value": "",
       "extractSettings": {
        "expression": "$.code"
       }
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.login exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$.login",
       "value": "",
       "extractSettings": {
        "expression": "$.login"
       }
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "loginId",
       "expression": "$.login",
       "subject": "responseJson"
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "code",
       "expression": "$.code",
       "subject": "responseJson"
      }
     }
    ],
    "auth": {
     "type": "noauth"
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988406
  },
  {
   "id": "step-2",
   "number": 2,
   "name": "Đổi code lấy token (authorization_code)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988104,
    "name": "Đổi code lấy token (authorization_code)",
    "path": "/oauth2/token",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "x-www-form-urlencoded",
     "parameters": [
      {
       "name": "grant_type",
       "value": "authorization_code",
       "enable": true,
       "type": "string"
      },
      {
       "name": "code",
       "value": "{{code}}",
       "enable": true,
       "type": "string"
      },
      {
       "name": "client_id",
       "value": "{{clientId}}",
       "enable": true,
       "type": "string"
      },
      {
       "name": "client_secret",
       "value": "{{clientSecret}}",
       "enable": true,
       "type": "string"
      }
     ]
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.access_token exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$.access_token",
       "value": "",
       "extractSettings": {
        "expression": "$.access_token"
       }
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.token_type == Bearer",
       "subject": "responseJson",
       "comparison": "equal",
       "path": "$.token_type",
       "value": "Bearer",
       "extractSettings": {
        "expression": "$.token_type"
       }
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "userToken",
       "expression": "$.access_token",
       "subject": "responseJson"
      }
     }
    ],
    "auth": {},
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988104
  },
  {
   "id": "step-3",
   "number": 3,
   "name": "Tạo client theo dữ liệu",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988103,
    "name": "Tạo client theo dữ liệu",
    "path": "/admin/projects/{{projectId}}/client",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "json",
     "data": "{{admin_body}}"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == {{expected_status}}",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "{{expected_status}}"
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const c = pm.iterationData.get('expected_code'), m = pm.iterationData.get('expected_message'); let j = {}; try { j = pm.response.json(); } catch (e) {} const is = j.issue || []; if (c) { pm.test('issue code = ' + c, () => pm.expect(is.length ? is[0].code : '').to.eql(c)); } if (m) { pm.test('details.text = ' + m, () => pm.expect(is.map(i => (i.details || {}).text)).to.include(m)); }"
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{userToken}}"
     }
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988103
  }
 ]
}
