# Chỉ để lại thứ cần cho `go build ./apps/auth/cmd/auth`: go.mod, go.sum, pkg/ (thư viện dùng chung) và apps/auth. Mọi app khác, test hạ tầng,
# tài liệu, manifest và dữ liệu cục bộ đều ra ngoài để context nhỏ và cache lớp `COPY . ./` ổn định khi chỉ đổi thứ không liên quan.
*
!go.mod
!go.sum
!pkg
!apps/auth

# trong phần được giữ lại
**/*_test.go
apps/auth/tests
apps/auth/docs/*.md
**/.env
**/.env.*
**/*.db
**/*.db-shm
**/*.db-wal
**/storage
**/.git
**/.DS_Store
