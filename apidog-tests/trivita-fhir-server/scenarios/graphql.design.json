{
 "slug": "graphql",
 "name": "POST $graphql (chỉ đọc)",
 "priority": 1,
 "steps": [
  {
   "name": "Đăng nhập admin project (auth /auth/login)",
   "endpointId": "auth-login",
   "method": "POST",
   "path": "{{authUrl}}/auth/login",
   "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}",
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.code exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "adm_code",
      "expression": "$.code",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "Đổi code lấy token admin (authorization_code)",
   "endpointId": "auth-token",
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "form": {
    "grant_type": "authorization_code",
    "code": "{{adm_code}}",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "bearerToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "(setup) POST Patient",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/Patient",
   "body": "{\"resourceType\": \"Patient\", \"name\": [{\"family\": \"Gq-{{case_id}}-{{$timestamp}}\", \"given\": [\"Qa\"]}], \"gender\": \"male\"}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 201",
    "$.id exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "patient_id",
      "expression": "$.id",
      "subject": "responseJson"
     }
    },
    {
     "type": "extractor",
     "data": {
      "variableName": "marker",
      "expression": "$.name[0].family",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "POST $graphql theo data",
   "endpointId": 47548492,
   "method": "POST",
   "path": "/fhir/R4/$graphql",
   "headers": {
    "Content-Type": "application/json"
   },
   "body": "{\"query\": {{gql_query}}, \"variables\": {\"id\": \"{{patient_id}}\", \"f\": \"{{marker}}\"}}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == {{expected_status}}"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const code = pm.iterationData.get('expected_code'); const msg = pm.iterationData.get('expected_message'); let b = {}; try { b = pm.response.json(); } catch (x) {} const issue = (b.issue && b.issue[0]) || {}; const text = (issue.details && issue.details.text) || (b.errors && b.errors[0] && b.errors[0].message) || ''; if (code) { pm.test('issue.code == ' + code, () => pm.expect(issue.code).to.eql(code)); } if (msg) { pm.test('thông điệp chứa: ' + msg, () => pm.expect(text).to.include(msg)); }"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const p = pm.iterationData.get('expected_path'); let v = pm.iterationData.get('expected_value'); if (p) { if (v === 'PATIENT_ID') { v = pm.variables.get('patient_id'); } const b = pm.response.json(); let cur = b; p.split('.').forEach(k => { cur = (cur === null || cur === undefined) ? cur : cur[k]; }); pm.test(p + ' == ' + v, () => pm.expect(String(cur)).to.eql(String(v))); }"
     }
    }
   ],
   "custom": true
  }
 ]
}
