  {
   "id": "step-2",
   "number": 2,
   "name": "GET /auth/me không Authorization → 401 + WWW-Authenticate",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988306,
    "name": "GET /auth/me không Authorization → 401 + WWW-Authenticate",
    "path": "/auth/me",
    "method": "get",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "none"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 401",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "401"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.issue[0].code == login",
       "subject": "responseJson",
       "comparison": "equal",
       "path": "$.issue[0].code",
       "value": "login",
       "extractSettings": {
        "expression": "$.issue[0].code"
       }
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "pm.test('WWW-Authenticate Bearer realm=auth', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer realm=\"auth\"'));"
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "pm.test('Cache-Control no-store', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));"
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "pm.test('X-Content-Type-Options nosniff', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));"
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "pm.test('có X-Request-Id', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);"
     }
    ],
    "auth": {
     "type": "noauth"
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988306
  },
