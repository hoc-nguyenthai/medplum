      "data": {
       "name": "status == 401",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "401"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.issue[0].code == login",
       "subject": "responseJson",
       "comparison": "equal",
       "path": "$.issue[0].code",
