{
 "slug": "terminology-lookup",
 "name": "CodeSystem/$lookup",
 "priority": 1,
 "steps": [
  {
   "name": "Đăng nhập admin project (auth /auth/login)",
   "endpointId": "auth-login",
   "method": "POST",
   "path": "{{authUrl}}/auth/login",
   "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}",
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.code exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "adm_code",
      "expression": "$.code",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "Đổi code lấy token admin (authorization_code)",
   "endpointId": "auth-token",
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "form": {
    "grant_type": "authorization_code",
    "code": "{{adm_code}}",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "bearerToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "(setup) POST CodeSystem (A > A1, B)",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/CodeSystem",
   "body": "{\"resourceType\": \"CodeSystem\", \"status\": \"active\", \"content\": \"complete\", \"url\": \"http://qa.trivita.test/cs/{{case_id}}-{{$timestamp}}\", \"concept\": [{\"code\": \"A\", \"display\": \"Alpha\", \"concept\": [{\"code\": \"A1\", \"display\": \"Alpha one\"}]}, {\"code\": \"B\", \"display\": \"Beta\"}]}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 201"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "cs_url",
      "expression": "$.url",
      "subject": "responseJson"
     }
    },
    {
     "type": "extractor",
     "data": {
      "variableName": "cs_id",
      "expression": "$.id",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "GET CodeSystem/$lookup theo data",
   "endpointId": 47548519,
   "method": "GET",
   "path": "/fhir/R4/CodeSystem/$lookup",
   "query": {
    "{{sys_name}}": "{{cs_url}}{{sys_suffix}}",
    "{{code_name}}": "{{code_value}}",
    "{{prop_name}}": "{{prop_value}}"
   },
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == {{expected_status}}"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const code = pm.iterationData.get('expected_code'); const msg = pm.iterationData.get('expected_message'); let b = {}; try { b = pm.response.json(); } catch (x) {} const issue = (b.issue && b.issue[0]) || {}; const text = (issue.details && issue.details.text) || (b.errors && b.errors[0] && b.errors[0].message) || ''; if (code) { pm.test('issue.code == ' + code, () => pm.expect(issue.code).to.eql(code)); } if (msg) { pm.test('thông điệp chứa: ' + msg, () => pm.expect(text).to.include(msg)); }"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const d = pm.iterationData.get('expected_display'); if (d) { const p = pm.response.json().parameter.find(x => x.name === 'display'); pm.test('display == ' + d, () => pm.expect(p && p.valueString).to.eql(d)); }"
     }
    }
   ],
   "custom": true
  }
 ]
}
