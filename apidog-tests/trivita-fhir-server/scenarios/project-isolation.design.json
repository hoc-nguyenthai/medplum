{
 "slug": "project-isolation",
 "name": "Cô lập dữ liệu giữa hai project",
 "priority": 1,
 "steps": [
  {
   "name": "Đăng nhập admin project (auth /auth/login)",
   "endpointId": "auth-login",
   "method": "POST",
   "path": "{{authUrl}}/auth/login",
   "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}",
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.code exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "adm_code",
      "expression": "$.code",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "Đổi code lấy token admin (authorization_code)",
   "endpointId": "auth-token",
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "form": {
    "grant_type": "authorization_code",
    "code": "{{adm_code}}",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "bearerToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "(A) POST Patient",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/Patient",
   "body": "{\"resourceType\": \"Patient\", \"name\": [{\"family\": \"Iso-{{case_id}}-{{$timestamp}}\", \"given\": [\"Qa\"]}], \"gender\": \"male\"}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 201",
    "$.id exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "patient_id",
      "expression": "$.id",
      "subject": "responseJson"
     }
    },
    {
     "type": "extractor",
     "data": {
      "variableName": "marker",
      "expression": "$.name[0].family",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "Token project B",
   "endpointId": "auth-token",
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "form": {
    "grant_type": "client_credentials",
    "client_id": "{{otherClientId}}",
    "client_secret": "{{otherClientSecret}}"
   },
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "bearerTokenB",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "(B) GET Patient/{id} → 404",
   "endpointId": 47548498,
   "method": "GET",
   "path": "/fhir/R4/Patient/{{patient_id}}",
   "auth": "Bearer {{bearerTokenB}}",
   "assertions": [
    "status == 404",
    "$.issue[0].code == not-found"
   ],
   "custom": true
  },
  {
   "name": "(B) PUT Patient/{id} → 404",
   "endpointId": 47548499,
   "method": "PUT",
   "path": "/fhir/R4/Patient/{{patient_id}}",
   "body": "{\"resourceType\": \"Patient\", \"id\": \"{{patient_id}}\", \"name\": [{\"family\": \"Hack\", \"given\": [\"Qa\"]}]}",
   "auth": "Bearer {{bearerTokenB}}",
   "assertions": [
    "status == 404"
   ],
   "custom": true
  },
  {
   "name": "(B) DELETE Patient/{id} → 404",
   "endpointId": 47548500,
   "method": "DELETE",
   "path": "/fhir/R4/Patient/{{patient_id}}",
   "auth": "Bearer {{bearerTokenB}}",
   "assertions": [
    "status == 404"
   ],
   "custom": true
  },
  {
   "name": "(B) GET _history → 404",
   "endpointId": 47548502,
   "method": "GET",
   "path": "/fhir/R4/Patient/{{patient_id}}/_history",
   "auth": "Bearer {{bearerTokenB}}",
   "assertions": [
    "status == 404"
   ],
   "custom": true
  },
  {
   "name": "(B) GET $everything → 404",
   "endpointId": 47548512,
   "method": "GET",
   "path": "/fhir/R4/Patient/{{patient_id}}/$everything",
   "query": {
    "_count": "10",
    "_type": "Patient",
    "_since": "1970-01-01T00:00:00Z"
   },
   "auth": "Bearer {{bearerTokenB}}",
   "assertions": [
    "status == 404"
   ],
   "custom": true
  },
  {
   "name": "(B) tìm theo family của A → 0 kết quả",
   "endpointId": 47548494,
   "method": "GET",
   "path": "/fhir/R4/Patient?family={{marker}}&_total=accurate",
   "auth": "Bearer {{bearerTokenB}}",
   "assertions": [
    "status == 200",
    "$.total == 0"
   ],
   "custom": true
  },
  {
   "name": "(A) vẫn đọc được → 200",
   "endpointId": 47548498,
   "method": "GET",
   "path": "/fhir/R4/Patient/{{patient_id}}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200",
    "$.id == {{patient_id}}"
   ]
  }
 ]
}
