{"slug": "auth-wellknown-caching", "name": "Auth | JWKS ETag và 304", "priority": 1, "steps": [{"name": "JWKS lần 1: lưu ETag", "endpointId": 47548420, "method": "GET", "path": "/.well-known/jwks.json", "assertions": ["status == 200"], "postProcessors": [{"type": "customScript", "data": {"script": "const e = pm.response.headers.get('ETag'); pm.test('có ETag', () => pm.expect(e).to.be.a('string').and.not.empty); pm.variables.set('etag', e);"}}, {"type": "customScript", "data": {"script": "pm.test('Cache-Control public, max-age=300', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('max-age=300'));"}}]}, {"name": "JWKS lần 2: If-None-Match đúng ETag → 304", "endpointId": 47548420, "method": "GET", "path": "/.well-known/jwks.json", "headers": {"If-None-Match": "{{etag}}"}, "assertions": ["status == 304"]}, {"name": "JWKS: If-None-Match lạ → 200", "endpointId": 47548420, "method": "GET", "path": "/.well-known/jwks.json", "headers": {"If-None-Match": "\"khong-khop\""}, "assertions": ["status == 200", "$.keys is array"]}]}
