{"slug": "auth-user-login-lifecycle", "name": "Auth | Vòng đời đăng nhập admin: login → token → me → userinfo → revoke", "priority": 0, "steps": [{"name": "Đăng nhập admin (email + mật khẩu)", "endpointId": 47548452, "method": "POST", "path": "/auth/login", "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}", "auth": "none", "assertions": ["status == 200", "$.code exists", "$.login exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "loginId", "expression": "$.login", "subject": "responseJson"}}, {"type": "extractor", "data": {"variableName": "code", "expression": "$.code", "subject": "responseJson"}}]}, {"name": "Đổi code lấy token (authorization_code)", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "authorization_code", "code": "{{code}}", "client_id": "{{clientId}}", "client_secret": "{{clientSecret}}"}, "assertions": ["status == 200", "$.access_token exists", "$.token_type == Bearer"], "postProcessors": [{"type": "extractor", "data": {"variableName": "userToken", "expression": "$.access_token", "subject": "responseJson"}}]}, {"name": "GET /auth/me của admin", "endpointId": 47548454, "method": "GET", "path": "/auth/me", "auth": "Bearer {{userToken}}", "assertions": ["status == 200", "$.user.email == {{adminEmail}}", "$.project.id == {{projectId}}", "$.membership.admin == true", "$.security.sessions is array"]}, {"name": "GET /oauth2/userinfo (scope profile email)", "endpointId": 47548483, "method": "GET", "path": "/oauth2/userinfo", "auth": "Bearer {{userToken}}", "assertions": ["status == 200", "$.email == {{adminEmail}}", "$.sub exists", "$.email_verified exists"]}, {"name": "GET /auth/mfa/status", "endpointId": 47548461, "method": "GET", "path": "/auth/mfa/status", "auth": "Bearer {{userToken}}", "assertions": ["status == 200"]}, {"name": "Introspect token admin (cùng client)", "endpointId": 47548478, "method": "POST", "path": "/oauth2/introspect", "form": {"token": "{{userToken}}"}, "auth": "Bearer {{userToken}}", "assertions": ["status == 200", "$.active == true"]}, {"name": "Thu hồi phiên bằng loginId", "endpointId": 47548469, "method": "POST", "path": "/auth/revoke", "body": "{\"loginId\": \"{{loginId}}\"}", "auth": "Bearer {{userToken}}", "assertions": ["status == 200"]}, {"name": "Sau revoke: /auth/me → 401", "endpointId": 47548454, "method": "GET", "path": "/auth/me", "auth": "Bearer {{userToken}}", "assertions": ["status == 401"]}, {"name": "Revoke lần hai bằng token chết → 401", "endpointId": 47548469, "method": "POST", "path": "/auth/revoke", "body": "{\"loginId\": \"{{loginId}}\"}", "auth": "Bearer {{userToken}}", "assertions": ["status == 401"]}]}
