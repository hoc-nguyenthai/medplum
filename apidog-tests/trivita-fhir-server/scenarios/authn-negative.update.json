     {
      "type": "customScript",
      "enable": true,
      "data": "pm.test('thông điệp thiếu token', () => pm.expect(pm.response.json().issue[0].details.text).to.include('Thiếu')); pm.test('header WWW-Authenticate chứa Bearer realm=\"fhir\"', () => pm.expect(pm.response.headers.get('WWW-Authenticate') || '').to.include('Bearer realm=\"fhir\"'));"
     }
    ],
    "auth": {
     "type": "noauth"
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988477
