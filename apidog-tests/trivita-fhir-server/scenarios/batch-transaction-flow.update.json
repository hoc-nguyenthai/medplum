{
 "steps": [
  {
   "id": "step-1",
   "number": 1,
   "name": "Đăng nhập admin project (auth /auth/login)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988145,
    "name": "Đăng nhập admin project (auth /auth/login)",
    "path": "{{authUrl}}/auth/login",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "json",
     "data": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.code exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$.code",
       "value": "",
       "extractSettings": {
        "expression": "$.code"
       }
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "adm_code",
       "expression": "$.code",
       "subject": "responseJson"
      }
     }
    ],
    "auth": {
     "type": "noauth"
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988145
  },
  {
   "id": "step-2",
   "number": 2,
   "name": "Đổi code lấy token admin (authorization_code)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988144,
    "name": "Đổi code lấy token admin (authorization_code)",
    "path": "{{authUrl}}/oauth2/token",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "x-www-form-urlencoded",
     "parameters": [
      {
       "name": "grant_type",
       "value": "authorization_code",
       "enable": true,
       "type": "string"
      },
      {
       "name": "code",
       "value": "{{adm_code}}",
       "enable": true,
       "type": "string"
      },
      {
       "name": "client_id",
       "value": "{{clientId}}",
       "enable": true,
       "type": "string"
      },
      {
       "name": "client_secret",
       "value": "{{clientSecret}}",
       "enable": true,
       "type": "string"
      }
     ]
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.access_token exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$.access_token",
       "value": "",
       "extractSettings": {
        "expression": "$.access_token"
       }
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "bearerToken",
       "expression": "$.access_token",
       "subject": "responseJson"
      }
     }
    ],
    "auth": {
     "type": "noauth"
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988144
  },
  {
   "id": "step-3",
   "number": 3,
   "name": "POST / batch (3 entry)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988143,
    "name": "POST / batch (3 entry)",
    "path": "/fhir/R4",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [
      {
       "name": "Content-Type",
       "value": "application/fhir+json",
       "enable": true
      }
     ],
     "cookie": []
    },
    "requestBody": {
     "type": "json",
     "data": "{\"resourceType\": \"Bundle\", \"type\": \"batch\", \"entry\": [{\"request\": {\"method\": \"POST\", \"url\": \"Patient\"}, \"resource\": {\"resourceType\": \"Patient\", \"name\": [{\"family\": \"Batch-{{$timestamp}}\", \"given\": [\"Qa\"]}], \"gender\": \"male\"}}, {\"request\": {\"method\": \"GET\", \"url\": \"Patient?family=khong-co-{{$timestamp}}\"}}, {\"request\": {\"method\": \"GET\", \"url\": \"Patient/00000000-0000-4000-8000-000000000000\"}}]}"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.resourceType == Bundle",
       "subject": "responseJson",
       "comparison": "equal",
       "path": "$.resourceType",
       "value": "Bundle",
       "extractSettings": {
        "expression": "$.resourceType"
       }
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.type == batch-response",
       "subject": "responseJson",
       "comparison": "equal",
       "path": "$.type",
       "value": "batch-response",
       "extractSettings": {
        "expression": "$.type"
       }
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.entry[0].response.status == 201 Created",
       "subject": "responseJson",
       "comparison": "equal",
       "path": "$.entry[0].response.status",
       "value": "201 Created",
       "extractSettings": {
        "expression": "$.entry[0].response.status"
       }
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const e = pm.response.json().entry; pm.test('entry[1] search 200', () => pm.expect(e[1].response.status).to.include('200')); pm.test('entry[2] 404 (lỗi riêng entry, Bundle vẫn 200)', () => pm.expect(e[2].response.status).to.include('404'));"
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{bearerToken}}"
     }
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988143
  },
