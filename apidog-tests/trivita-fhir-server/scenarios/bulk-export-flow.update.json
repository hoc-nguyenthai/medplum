       "comparison": "equal",
       "path": "$.requiresAccessToken",
       "value": "true",
       "extractSettings": {
        "expression": "$.requiresAccessToken"
       }
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "pm.test(\"$.output is array\", () => pm.expect(Array.isArray(pm.response.json().output)).to.eql(true));"
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const u = (pm.response.json().output || [])[0]; pm.test('có file output', () => pm.expect(u).to.not.eql(undefined)); if (u) { pm.variables.set('bin_id', String(u.url).split('/').pop()); }"
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{bearerToken}}"
     }
    },
    "id": 65410449
