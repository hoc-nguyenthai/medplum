{"slug": "auth-client-credentials-lifecycle", "name": "Auth | Vòng đời client_credentials: token → me → userinfo → introspect → logout", "priority": 0, "steps": [{"name": "Lấy token client_credentials", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "client_credentials", "client_id": "{{clientId}}", "client_secret": "{{clientSecret}}", "scope": "openid"}, "assertions": ["status == 200", "$.access_token exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "ccToken", "expression": "$.access_token", "subject": "responseJson"}}]}, {"name": "Introspect chính token (cùng client) → active", "endpointId": 47548478, "method": "POST", "path": "/oauth2/introspect", "form": {"token": "{{ccToken}}"}, "auth": "Bearer {{ccToken}}", "assertions": ["status == 200", "$.active == true", "$.client_id == {{clientId}}", "$.iss exists"]}, {"name": "GET /auth/me của ClientApplication", "endpointId": 47548454, "method": "GET", "path": "/auth/me", "auth": "Bearer {{ccToken}}", "assertions": ["status == 200", "$.project.id == {{projectId}}", "$.user not exists", "$.security not exists"]}, {"name": "GET /oauth2/userinfo (chỉ sub)", "endpointId": 47548483, "method": "GET", "path": "/oauth2/userinfo", "auth": "Bearer {{ccToken}}", "assertions": ["status == 200", "$.sub == {{clientId}}", "$.email not exists"]}, {"name": "POST /oauth2/userinfo cùng kết quả", "endpointId": 47548484, "method": "POST", "path": "/oauth2/userinfo", "auth": "Bearer {{ccToken}}", "assertions": ["status == 200", "$.sub == {{clientId}}"]}, {"name": "Đăng xuất POST /oauth2/logout", "endpointId": 47548480, "method": "POST", "path": "/oauth2/logout", "auth": "Bearer {{ccToken}}", "assertions": ["status == 200"]}, {"name": "Sau logout: /auth/me → 401", "endpointId": 47548454, "method": "GET", "path": "/auth/me", "auth": "Bearer {{ccToken}}", "assertions": ["status == 401", "$.issue[0].code == login"]}, {"name": "Sau logout: introspect bằng token chết → 401", "endpointId": 47548478, "method": "POST", "path": "/oauth2/introspect", "form": {"token": "{{ccToken}}"}, "auth": "Bearer {{ccToken}}", "assertions": ["status == 401"]}]}
