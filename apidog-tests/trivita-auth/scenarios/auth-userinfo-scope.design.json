{"slug": "auth-userinfo-scope", "name": "Auth | GET /oauth2/userinfo theo scope (data-driven)", "priority": 1, "steps": [{"name": "Đăng nhập admin với scope theo dữ liệu", "endpointId": 47548452, "method": "POST", "path": "/auth/login", "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"{{ui_scope}}\"}", "auth": "none", "assertions": ["status == 200", "$.code exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "code", "expression": "$.code", "subject": "responseJson"}}]}, {"name": "Đổi code lấy token", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "authorization_code", "code": "{{code}}", "client_id": "{{clientId}}", "client_secret": "{{clientSecret}}"}, "assertions": ["status == 200"], "postProcessors": [{"type": "extractor", "data": {"variableName": "userToken", "expression": "$.access_token", "subject": "responseJson"}}]}, {"name": "GET /oauth2/userinfo kiểm claim theo scope", "endpointId": 47548483, "method": "GET", "path": "/oauth2/userinfo", "auth": "Bearer {{userToken}}", "assertions": ["status == {{expected_status}}"], "postProcessors": [{"type": "customScript", "data": {"script": "const j = pm.response.json(); const has = (s) => (pm.iterationData.get(s) || '').split(',').filter(Boolean); has('present').forEach(k => pm.test('có ' + k, () => pm.expect(j[k]).to.not.equal(undefined))); has('absent').forEach(k => pm.test('không có ' + k, () => pm.expect(j[k]).to.equal(undefined)));"}}]}]}
