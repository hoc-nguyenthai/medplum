{"slug": "auth-signup-lifecycle", "name": "Auth | Đăng ký → tạo project → token → đổi mật khẩu", "priority": 1, "steps": [{"name": "Đăng ký tài khoản mới", "endpointId": 47548465, "method": "POST", "path": "/auth/newuser", "body": "{\"firstName\": \"QA\", \"lastName\": \"Signup\", \"email\": \"qa.signup.{{$timestamp}}{{$randomInt}}@example.org\", \"password\": \"Qa-Signup-2026-xK9\", \"projectId\": \"new\", \"codeChallenge\": \"E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM\", \"codeChallengeMethod\": \"S256\"}", "auth": "none", "assertions": ["status == 200", "$.login exists", "$.emailVerificationRequired == false"], "postProcessors": [{"type": "extractor", "data": {"variableName": "suLogin", "expression": "$.login", "subject": "responseJson"}}]}, {"name": "Tạo project mới", "endpointId": 47548464, "method": "POST", "path": "/auth/newproject", "body": "{\"login\": \"{{suLogin}}\", \"projectName\": \"QA Project {{$timestamp}}\"}", "auth": "none", "assertions": ["status == 200", "$.code exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "suCode", "expression": "$.code", "subject": "responseJson"}}]}, {"name": "Đổi code (PKCE) lấy token", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "authorization_code", "code": "{{suCode}}", "code_verifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"}, "assertions": ["status == 200", "$.access_token exists", "$.project.reference exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "suToken", "expression": "$.access_token", "subject": "responseJson"}}, {"type": "customScript", "data": {"script": "const ref = pm.response.json().project.reference; pm.variables.set('suProjectId', ref.split('/')[1]);"}}]}, {"name": "GET /auth/me: chủ project là admin", "endpointId": 47548454, "method": "GET", "path": "/auth/me", "auth": "Bearer {{suToken}}", "assertions": ["status == 200", "$.membership.admin == true", "$.project.id == {{suProjectId}}"]}, {"name": "Admin project mới đọc project của mình", "endpointId": 47548427, "method": "GET", "path": "/admin/projects/{{suProjectId}}", "auth": "Bearer {{suToken}}", "assertions": ["status == 200", "$.project.id == {{suProjectId}}"]}, {"name": "Admin project mới đọc project seed → 403 chung", "endpointId": 47548427, "method": "GET", "path": "/admin/projects/{{projectId}}", "auth": "Bearer {{suToken}}", "assertions": ["status == 403", "$.issue[0].code == forbidden", "$.issue[0].details.text == Forbidden"]}, {"name": "changepassword: mật khẩu cũ sai → 400", "endpointId": 47548445, "method": "POST", "path": "/auth/changepassword", "body": "{\"oldPassword\": \"sai-mat-khau-cu\", \"newPassword\": \"Qa-Signup-2026-new1\"}", "auth": "Bearer {{suToken}}", "assertions": ["status == 400", "$.issue[0].details.text == Incorrect password"]}, {"name": "changepassword: mật khẩu mới quá ngắn → 400", "endpointId": 47548445, "method": "POST", "path": "/auth/changepassword", "body": "{\"oldPassword\": \"Qa-Signup-2026-xK9\", \"newPassword\": \"short\"}", "auth": "Bearer {{suToken}}", "assertions": ["status == 400", "$.issue[0].details.text == Password must be at least 8 characters"]}, {"name": "changepassword đúng → 200", "endpointId": 47548445, "method": "POST", "path": "/auth/changepassword", "body": "{\"oldPassword\": \"Qa-Signup-2026-xK9\", \"newPassword\": \"Qa-Signup-2026-new1\"}", "auth": "Bearer {{suToken}}", "assertions": ["status == 200"]}, {"name": "Đổi mật khẩu thu hồi mọi phiên → /auth/me 401", "endpointId": 47548454, "method": "GET", "path": "/auth/me", "auth": "Bearer {{suToken}}", "assertions": ["status == 401"]}, {"name": "newproject dùng lại login đã cấp code → 400", "endpointId": 47548464, "method": "POST", "path": "/auth/newproject", "body": "{\"login\": \"{{suLogin}}\", \"projectName\": \"QA Project lan hai\"}", "auth": "none", "assertions": ["status == 400"]}]}
