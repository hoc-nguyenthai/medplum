{
 "steps": [
  {
   "id": "step-1",
   "number": 1,
   "name": "Đăng nhập admin project (auth /auth/login)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988253,
    "name": "Đăng nhập admin project (auth /auth/login)",
    "path": "{{authUrl}}/auth/login",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "json",
     "data": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.code exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$.code",
       "value": "",
       "extractSettings": {
        "expression": "$.code"
       }
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "adm_code",
       "expression": "$.code",
       "subject": "responseJson"
      }
     }
    ],
    "auth": {
     "type": "noauth"
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988253
  },
  {
   "id": "step-2",
   "number": 2,
   "name": "Đổi code lấy token admin (authorization_code)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988252,
    "name": "Đổi code lấy token admin (authorization_code)",
    "path": "{{authUrl}}/oauth2/token",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "x-www-form-urlencoded",
     "parameters": [
      {
       "name": "grant_type",
       "value": "authorization_code",
       "enable": true,
       "type": "string"
      },
      {
       "name": "code",
       "value": "{{adm_code}}",
       "enable": true,
       "type": "string"
      },
      {
       "name": "client_id",
       "value": "{{clientId}}",
       "enable": true,
       "type": "string"
      },
      {
       "name": "client_secret",
       "value": "{{clientSecret}}",
       "enable": true,
       "type": "string"
      }
     ]
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.access_token exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$.access_token",
       "value": "",
       "extractSettings": {
        "expression": "$.access_token"
       }
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "bearerToken",
       "expression": "$.access_token",
       "subject": "responseJson"
      }
     }
    ],
    "auth": {
     "type": "noauth"
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988252
  },
  {
   "id": "step-3",
   "number": 3,
   "name": "POST Patient (ident mới)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988251,
    "name": "POST Patient (ident mới)",
    "path": "/fhir/R4/Patient",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "json",
     "data": "{\"resourceType\": \"Patient\", \"identifier\": [{\"system\": \"urn:trivita:qa-mrn\", \"value\": \"cw-{{case_id}}-{{$timestamp}}\"}], \"name\": [{\"family\": \"Cond-{{$timestamp}}\", \"given\": [\"Qa\"]}]}"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 201",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "201"
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "patient_id",
       "expression": "$.id",
       "subject": "responseJson"
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "ident",
       "expression": "$.identifier[0].value",
       "subject": "responseJson"
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "v1",
       "expression": "$.meta.versionId",
       "subject": "responseJson"
      }
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{bearerToken}}"
     }
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988251
  },
