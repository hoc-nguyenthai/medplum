{
 "slug": "batch-transaction-flow",
 "name": "Batch và transaction (luồng)",
 "priority": 1,
 "steps": [
  {
   "name": "Đăng nhập admin project (auth /auth/login)",
   "endpointId": "auth-login",
   "method": "POST",
   "path": "{{authUrl}}/auth/login",
   "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}",
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.code exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "adm_code",
      "expression": "$.code",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "Đổi code lấy token admin (authorization_code)",
   "endpointId": "auth-token",
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "form": {
    "grant_type": "authorization_code",
    "code": "{{adm_code}}",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "bearerToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "POST / batch (3 entry)",
   "endpointId": 47548491,
   "method": "POST",
   "path": "/fhir/R4",
   "headers": {
    "Content-Type": "application/fhir+json"
   },
   "body": "{\"resourceType\": \"Bundle\", \"type\": \"batch\", \"entry\": [{\"request\": {\"method\": \"POST\", \"url\": \"Patient\"}, \"resource\": {\"resourceType\": \"Patient\", \"name\": [{\"family\": \"Batch-{{$timestamp}}\", \"given\": [\"Qa\"]}], \"gender\": \"male\"}}, {\"request\": {\"method\": \"GET\", \"url\": \"Patient?family=khong-co-{{$timestamp}}\"}}, {\"request\": {\"method\": \"GET\", \"url\": \"Patient/00000000-0000-4000-8000-000000000000\"}}]}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200",
    "$.resourceType == Bundle",
    "$.type == batch-response",
    "$.entry[0].response.status == 201 Created"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const e = pm.response.json().entry; pm.test('entry[1] search 200', () => pm.expect(e[1].response.status).to.include('200')); pm.test('entry[2] 404 (lỗi riêng entry, Bundle vẫn 200)', () => pm.expect(e[2].response.status).to.include('404'));"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "POST / transaction (urn:uuid)",
   "endpointId": 47548491,
   "method": "POST",
   "path": "/fhir/R4",
   "headers": {
    "Content-Type": "application/fhir+json"
   },
   "body": "{\"resourceType\": \"Bundle\", \"type\": \"transaction\", \"entry\": [{\"fullUrl\": \"urn:uuid:11111111-1111-4111-8111-111111111111\", \"request\": {\"method\": \"POST\", \"url\": \"Patient\"}, \"resource\": {\"resourceType\": \"Patient\", \"name\": [{\"family\": \"Txn-{{$timestamp}}\", \"given\": [\"Qa\"]}], \"gender\": \"female\"}}, {\"fullUrl\": \"urn:uuid:22222222-2222-4222-8222-222222222222\", \"request\": {\"method\": \"POST\", \"url\": \"Observation\"}, \"resource\": {\"resourceType\": \"Observation\", \"status\": \"final\", \"code\": {\"text\": \"qa\"}, \"subject\": {\"reference\": \"urn:uuid:11111111-1111-4111-8111-111111111111\"}}}]}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200",
    "$.type == transaction-response",
    "$.entry[0].response.status == 201 Created",
    "$.entry[1].response.status == 201 Created"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "obs_id",
      "expression": "$.entry[1].resource.id",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "GET Observation: subject đã được viết lại thành Patient/{id}",
   "endpointId": 47548498,
   "method": "GET",
   "path": "/fhir/R4/Observation/{{obs_id}}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('subject không còn urn:uuid', () => pm.expect(pm.response.json().subject.reference).to.match(/^Patient\\//));"
     }
    }
   ]
  },
  {
   "name": "POST / transaction có entry lỗi → lỗi, rollback",
   "endpointId": 47548491,
   "method": "POST",
   "path": "/fhir/R4",
   "headers": {
    "Content-Type": "application/fhir+json"
   },
   "body": "{\"resourceType\": \"Bundle\", \"type\": \"transaction\", \"entry\": [{\"request\": {\"method\": \"POST\", \"url\": \"Patient\", \"ifNoneExist\": \"identifier=urn:trivita:qa-mrn|tx-{{case_id}}-{{$timestamp}}\"}, \"resource\": {\"resourceType\": \"Patient\", \"identifier\": [{\"system\": \"urn:trivita:qa-mrn\", \"value\": \"tx-{{case_id}}-{{$timestamp}}\"}], \"name\": [{\"family\": \"TxnFail-{{$timestamp}}\", \"given\": [\"Qa\"]}]}}, {\"request\": {\"method\": \"POST\", \"url\": \"Observation\"}, \"resource\": {\"resourceType\": \"Observation\"}}]}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 400",
    "$.resourceType == OperationOutcome"
   ],
   "custom": true
  },
  {
   "name": "GET Patient?identifier (rollback: không có)",
   "endpointId": 47548494,
   "method": "GET",
   "path": "/fhir/R4/Patient?identifier=urn:trivita:qa-mrn|tx-{{case_id}}-{{$timestamp}}&_total=accurate",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200",
    "$.total == 0"
   ],
   "custom": true
  }
 ]
}
