{
 "steps": [
  {
   "id": "step-1",
   "number": 1,
   "name": "Đăng nhập admin project (auth /auth/login)",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988294,
    "name": "Đăng nhập admin project (auth /auth/login)",
    "path": "{{authUrl}}/auth/login",
    "method": "post",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "json",
     "data": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     },
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "$.code exists",
       "subject": "responseJson",
       "comparison": "exists",
       "path": "$.code",
       "value": "",
       "extractSettings": {
        "expression": "$.code"
       }
      }
     },
     {
      "type": "extractor",
      "enable": true,
      "data": {
       "variableType": "local",
       "variableName": "adm_code",
       "expression": "$.code",
       "subject": "responseJson"
      }
     }
    ],
    "auth": {
     "type": "noauth"
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988294
  },
  {
