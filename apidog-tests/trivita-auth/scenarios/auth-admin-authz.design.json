{"slug": "auth-admin-authz", "name": "Auth | Admin: phân quyền (client không admin, project khác, membership lạ)", "priority": 1, "steps": [{"name": "Lấy token client_credentials", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "client_credentials", "client_id": "{{clientId}}", "client_secret": "{{clientSecret}}"}, "assertions": ["status == 200", "$.access_token exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "ccToken", "expression": "$.access_token", "subject": "responseJson"}}]}, {"name": "Đăng nhập admin (email + mật khẩu)", "endpointId": 47548452, "method": "POST", "path": "/auth/login", "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}", "auth": "none", "assertions": ["status == 200", "$.code exists", "$.login exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "loginId", "expression": "$.login", "subject": "responseJson"}}, {"type": "extractor", "data": {"variableName": "code", "expression": "$.code", "subject": "responseJson"}}]}, {"name": "Đổi code lấy token (authorization_code)", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "authorization_code", "code": "{{code}}", "client_id": "{{clientId}}", "client_secret": "{{clientSecret}}"}, "assertions": ["status == 200", "$.access_token exists", "$.token_type == Bearer"], "postProcessors": [{"type": "extractor", "data": {"variableName": "userToken", "expression": "$.access_token", "subject": "responseJson"}}]}, {"name": "Client chưa admin đọc project → 403", "endpointId": 47548427, "method": "GET", "path": "/admin/projects/{{projectId}}", "auth": "Bearer {{ccToken}}", "assertions": ["status == 403", "$.issue[0].code == forbidden"]}, {"name": "Client chưa admin tạo client → 403", "endpointId": 47548428, "method": "POST", "path": "/admin/projects/{{projectId}}/client", "body": "{\"name\": \"khong-duoc\"}", "auth": "Bearer {{ccToken}}", "assertions": ["status == 403"]}, {"name": "Client chưa admin mời user → 403", "endpointId": 47548431, "method": "POST", "path": "/admin/projects/{{projectId}}/invite", "body": "{\"resourceType\": \"Practitioner\", \"firstName\": \"A\", \"lastName\": \"B\", \"email\": \"qa.never@example.org\", \"sendEmail\": false}", "auth": "Bearer {{ccToken}}", "assertions": ["status == 403"]}, {"name": "Admin đọc project khác → 403", "endpointId": 47548427, "method": "GET", "path": "/admin/projects/00000000-0000-4000-8000-000000000001", "auth": "Bearer {{userToken}}", "assertions": ["status == 403", "$.issue[0].details.text == Forbidden"]}, {"name": "Admin đặt setting ở project khác → 403", "endpointId": 47548439, "method": "POST", "path": "/admin/projects/00000000-0000-4000-8000-000000000001/settings", "body": "[]", "auth": "Bearer {{userToken}}", "assertions": ["status == 403"]}, {"name": "Admin đọc membership không tồn tại → 403 chung", "endpointId": 47548432, "method": "GET", "path": "/admin/projects/{{projectId}}/members/00000000-0000-4000-8000-000000000000", "auth": "Bearer {{userToken}}", "assertions": ["status == 403"]}, {"name": "Admin xóa membership không tồn tại → 403 chung", "endpointId": 47548434, "method": "DELETE", "path": "/admin/projects/{{projectId}}/members/00000000-0000-4000-8000-000000000000", "auth": "Bearer {{userToken}}", "assertions": ["status == 403"]}, {"name": "Admin xoay secret client không tồn tại → 403 chung", "endpointId": 47548429, "method": "POST", "path": "/admin/projects/{{projectId}}/client/00000000-0000-4000-8000-000000000000/rotate-secret", "body": "{}", "auth": "Bearer {{userToken}}", "assertions": ["status == 403"]}, {"name": "Body hỏng của người không admin vẫn nhận 400 trước 403 (thứ tự kiểm tra)", "endpointId": 47548428, "method": "POST", "path": "/admin/projects/{{projectId}}/client", "body": "{", "auth": "Bearer {{ccToken}}", "assertions": ["status == 400", "$.issue[0].details.text == Content could not be parsed"]}]}
