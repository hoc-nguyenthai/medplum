  {
   "id": "step-6",
   "number": 6,
   "name": "GET Patient/{id}/$everything theo data",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988289,
    "name": "GET Patient/{id}/$everything theo data",
    "path": "/fhir/R4/Patient/{{patient_id}}/$everything?_count={{ev_count}}&_type={{ev_type}}&_since={{ev_since}}",
    "method": "get",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "none"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == {{expected_status}}",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "{{expected_status}}"
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const code = pm.iterationData.get('expected_code'); const msg = pm.iterationData.get('expected_message'); let b = {}; try { b = pm.response.json(); } catch (x) {} const issue = (b.issue && b.issue[0]) || {}; const text = (issue.details && issue.details.text) || (b.errors && b.errors[0] && b.errors[0].message) || ''; if (code) { pm.test('issue.code == ' + code, () => pm.expect(issue.code).to.eql(code)); } if (msg) { pm.test('thông điệp chứa: ' + msg, () => pm.expect(text).to.include(msg)); }"
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const g = k => pm.iterationData.get(k); const b = pm.response.json(); const n = (b.entry || []).length; const has = k => g(k) !== undefined && g(k) !== ''; if (has('expected_entries')) { pm.test('số entry == ' + g('expected_entries'), () => pm.expect(n).to.eql(Number(g('expected_entries')))); } if (has('expected_total')) { pm.test('total == ' + g('expected_total'), () => pm.expect(b.total).to.eql(Number(g('expected_total')))); } const rel = r => (b.link || []).some(l => l.relation === r); if (has('expected_next')) { pm.test('link next == ' + g('expected_next'), () => pm.expect(rel('next')).to.eql(g('expected_next') === 'true')); } if (has('expected_prev')) { pm.test('link previous == ' + g('expected_prev'), () => pm.expect(rel('previous')).to.eql(g('expected_prev') === 'true')); } if (has('expected_first_birthdate')) { pm.test('entry[0].birthDate == ' + g('expected_first_birthdate'), () => pm.expect(b.entry[0].resource.birthDate).to.eql(g('expected_first_birthdate'))); }"
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{bearerToken}}"
     }
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988289
  },
