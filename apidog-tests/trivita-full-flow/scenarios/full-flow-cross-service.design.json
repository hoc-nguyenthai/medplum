{
 "slug": "full-flow-cross-service",
 "name": "Full flow: một JWT của auth dùng chung cho các service",
 "priority": 1,
 "steps": [
  {
   "name": "Lấy token client_credentials (auth)",
   "endpointId": 9100062,
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "auth": "none",
   "custom": true,
   "form": {
    "grant_type": "client_credentials",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "accessToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const base = '1.2.826.0.1.3680043.9.7777.' + Date.now() + (100 + Math.floor(Math.random() * 900));\npm.variables.set('studyUid', base + '.1'); pm.variables.set('seriesUid', base + '.1.1'); pm.variables.set('sop', base + '.1.1.1');\npm.variables.set('pid', 'QA-FF-' + Date.now());\npm.variables.set('topic', 'qa-ff-' + Date.now() + '-' + Math.floor(Math.random() * 1000000));"
     }
    }
   ]
  },
  {
   "name": "fhir: token của auth dùng được ở fhir-server",
   "endpointId": 9100063,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/Patient",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "query": {
    "_count": "1"
   },
   "assertions": [
    "status == 200"
   ]
  },
  {
   "name": "dicomweb: cùng token dùng được ở dicomweb",
   "endpointId": 9100064,
   "method": "GET",
   "path": "{{dicomUrl}}/dicomweb/studies",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 200"
   ]
  },
  {
   "name": "auth: token scope fhircast/*",
   "endpointId": 9100065,
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "auth": "none",
   "custom": true,
   "form": {
    "grant_type": "client_credentials",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}",
    "scope": "fhircast/*"
   },
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "wsToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "ws-gateway: token scope fhircast/* dùng được ở hub",
   "endpointId": 9100066,
   "method": "GET",
   "path": "{{wsUrl}}/fhircast/STU3/{{topic}}",
   "auth": "Bearer {{wsToken}}",
   "custom": true,
   "assertions": [
    "status == 200"
   ]
  },
  {
   "name": "auth: POST /oauth2/logout thu hồi phiên của token",
   "endpointId": 9100067,
   "method": "POST",
   "path": "{{authUrl}}/oauth2/logout",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 200"
   ]
  },
  {
   "name": "auth: sau logout /auth/me -> 401",
   "endpointId": 9100068,
   "method": "GET",
   "path": "{{authUrl}}/auth/me",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 401"
   ]
  },
  {
   "name": "fhir: token đã logout ở auth khi dùng ở fhir-server (ghi nhận hành vi: 200 hoặc 401)",
   "endpointId": 9100069,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/Patient",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "query": {
    "_count": "1"
   },
   "assertions": [],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"200 (JWT chỉ kiểm chữ ký) hoặc 401 (kiểm thu hồi): ghi nhận, không khẳng định\", () => { pm.expect([200, 401]).to.include(pm.response.code); });"
     }
    }
   ]
  }
 ]
}
