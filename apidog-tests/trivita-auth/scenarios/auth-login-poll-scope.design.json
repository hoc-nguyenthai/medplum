{"slug": "auth-login-poll-scope", "name": "Auth | GET /auth/login/{login}, /auth/scope, /auth/profile", "priority": 1, "steps": [{"name": "Đăng nhập admin", "endpointId": 47548452, "method": "POST", "path": "/auth/login", "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}", "auth": "none", "assertions": ["status == 200", "$.code exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "loginId", "expression": "$.login", "subject": "responseJson"}}, {"type": "extractor", "data": {"variableName": "code", "expression": "$.code", "subject": "responseJson"}}]}, {"name": "GET /auth/login/{login} phát code mới", "endpointId": 47548453, "method": "GET", "path": "/auth/login/{{loginId}}", "auth": "none", "assertions": ["status == 200", "$.code exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "code2", "expression": "$.code", "subject": "responseJson"}}]}, {"name": "Code cũ bị vô hiệu → Invalid code", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "authorization_code", "code": "{{code}}", "client_id": "{{clientId}}", "client_secret": "{{clientSecret}}"}, "assertions": ["status == 400", "$.error == invalid_request", "$.error_description == Invalid code"]}, {"name": "Scope mở rộng hơn lúc đăng nhập → 400 Invalid scope", "endpointId": 47548470, "method": "POST", "path": "/auth/scope", "body": "{\"login\": \"{{loginId}}\", \"scope\": \"openid profile email offline_access\"}", "auth": "none", "assertions": ["status == 400", "$.issue[0].details.text == Invalid scope"]}, {"name": "Thiếu scope → 400 Missing scope", "endpointId": 47548470, "method": "POST", "path": "/auth/scope", "body": "{\"login\": \"{{loginId}}\"}", "auth": "none", "assertions": ["status == 400", "$.issue[0].details.text == Missing scope"]}, {"name": "Thu hẹp scope → code mới", "endpointId": 47548470, "method": "POST", "path": "/auth/scope", "body": "{\"login\": \"{{loginId}}\", \"scope\": \"openid profile\"}", "auth": "none", "assertions": ["status == 200", "$.code exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "code3", "expression": "$.code", "subject": "responseJson"}}]}, {"name": "Thiếu profile → 400 Missing profile", "endpointId": 47548467, "method": "POST", "path": "/auth/profile", "body": "{\"login\": \"{{loginId}}\"}", "auth": "none", "assertions": ["status == 400", "$.issue[0].details.text == Missing profile"]}, {"name": "Đổi code mới nhất lấy token", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "authorization_code", "code": "{{code3}}", "client_id": "{{clientId}}", "client_secret": "{{clientSecret}}"}, "assertions": ["status == 200", "$.scope == openid profile"]}, {"name": "Login đã cấp token: GET /auth/login → 400 Login already granted", "endpointId": 47548453, "method": "GET", "path": "/auth/login/{{loginId}}", "auth": "none", "assertions": ["status == 400", "$.issue[0].details.text == Login already granted"]}, {"name": "GET /auth/login/abc → 400 Login ID is required", "endpointId": 47548453, "method": "GET", "path": "/auth/login/abc", "auth": "none", "assertions": ["status == 400", "$.issue[0].details.text == Login ID is required"]}, {"name": "GET /auth/login/<uuid lạ> → 404", "endpointId": 47548453, "method": "GET", "path": "/auth/login/00000000-0000-4000-8000-000000000000", "auth": "none", "assertions": ["status == 404", "$.issue[0].code == not-found"]}]}
