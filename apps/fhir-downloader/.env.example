# fhir-downloader: mẫu cấu hình. Biến chung với fhir-server giữ NGUYÊN tên để dùng chung một tệp môi trường (xem docs/config.md).
# Copy thành .env (đọc khi chạy ở thư mục này; không ghi đè biến môi trường thật).

# Tên service trong log và telemetry (OTEL_SERVICE_NAME thắng nếu đặt).
# APP_NAME=trivita-fhir-downloader
# Địa chỉ nghe của các probe (service không có route nghiệp vụ).
# HTTP_ADDR=:8009
# local | development | staging | production (staging/production áp ràng buộc chặt).
# ENVIRONMENT=local

# Hạn tối đa của /health/ready khi kiểm database và Redis.
# READINESS_TIMEOUT=2s
# Sau SIGTERM: readiness 503 nhưng vẫn chạy, để orchestrator gỡ instance.
# SHUTDOWN_DRAIN_DELAY=5s
# Thời gian tối đa chờ việc tải đang chạy xong sau khi hết drain (terminationGracePeriodSeconds phải lớn hơn tổng hai giá trị).
# SHUTDOWN_TIMEOUT=25s
# Hạn đọc phần đầu HTTP của mỗi yêu cầu probe.
# READ_HEADER_TIMEOUT=10s

# CÙNG schema `fhir` với fhir-server (fhir-downloader không migrate; chạy `fhir-server migrate up` trước).
# DATABASE_URL=postgres://fhir_app:***@postgres:5432/trivita?search_path=fhir
# Ghi log mọi câu SQL (chỉ gỡ lỗi).
# DATABASE_ECHO=false
# Từ chối khởi động nếu search_path không phải đúng một schema riêng (PostgreSQL).
# DATABASE_REQUIRE_SCHEMA=false
# DATABASE_MAX_OPEN_CONNS=20
# DATABASE_MAX_IDLE_CONNS=5
# DATABASE_CONN_MAX_LIFETIME=30m

# Redis của broker sự kiện (bắt buộc), cùng Redis với fhir-server (BROKER_DRIVER=redis).
# REDIS_URL=redis://localhost:6379/0
# Consumer group của service này; KHÁC "trivita" của fhir-server để cả hai cùng nhận mọi sự kiện.
# BROKER_GROUP=fhir-downloader

# Địa chỉ công khai của API FHIR (như fhir-server): URL bắt đầu bằng nó không bị tải.
# FHIR_BASE_URL=http://localhost:8005/fhir/R4
# Địa chỉ công khai của /storage nếu khác mặc định.
# FHIR_STORAGE_BASE_URL=

# Kho nội dung tệp tải về (bắt buộc), PHẢI trùng với fhir-server: file:<thư mục> hoặc s3:<bucket>[/<prefix>].
FHIR_BINARY_STORAGE=file:./blobs
# S3 (khi dùng s3:). Khóa truy cập chỉ từ biến môi trường.
# FHIR_S3_REGION=
# FHIR_S3_ENDPOINT=
# FHIR_S3_ACCESS_KEY_ID=
# FHIR_S3_SECRET_ACCESS_KEY=
# FHIR_S3_SESSION_TOKEN=
# FHIR_S3_SSE=

# Trần mặc định của một tệp tải về khi FHIR_AUTO_DOWNLOAD_MAX_BYTES là 0 (cùng biến với fhir-server).
# FHIR_STORAGE_MAX_UPLOAD_BYTES=268435456
# Trần kích thước một tệp tải về; 0: dùng FHIR_STORAGE_MAX_UPLOAD_BYTES.
# FHIR_AUTO_DOWNLOAD_MAX_BYTES=0
# Hạn của mỗi lần tải.
# FHIR_AUTO_DOWNLOAD_TIMEOUT=30s
# Chỉ tải URL bắt đầu bằng một trong các tiền tố (cách nhau bằng dấu phẩy); rỗng: mọi URL ngoài. Nên đặt ở production.
# FHIR_AUTO_DOWNLOAD_ALLOWED_PREFIXES=
# Tiền tố KHÔNG bao giờ tải; thắng danh sách cho phép.
# FHIR_AUTO_DOWNLOAD_IGNORED_PREFIXES=
# CHỈ dev: cho tải từ địa chỉ nội bộ (tắt chống SSRF). Cấm ở staging/production.
# FHIR_AUTO_DOWNLOAD_ALLOW_PRIVATE=false
