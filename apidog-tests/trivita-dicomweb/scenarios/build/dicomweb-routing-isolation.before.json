    "type": "customHttp",
    "relatedId": 988214,
    "disable": false,
    "customHttpRequest": {
     "createdAt": "2026-11-25T14:43:40.000Z",
     "updatedAt": "2026-11-25T14:43:40.000Z",
     "deletedAt": null,
     "id": 988214,
     "name": "Lấy access token (client_credentials của auth)",
     "method": "post",
     "path": "{{authUrl}}/oauth2/token",
     "requestBody": {
      "type": "application/x-www-form-urlencoded",
      "parameters": [
       {
        "name": "grant_type",
        "value": "client_credentials",
        "enable": true,
        "type": "string"
       },
       {
        "name": "client_id",
        "value": "{{clientId}}",
        "enable": true,
        "type": "string"
       },
       {
        "name": "client_secret",
        "value": "{{clientSecret}}",
        "enable": true,
        "type": "string"
       }
      ]
     },
     "parameters": {
      "path": [],
      "query": [],
      "header": [],
      "cookie": []
     },
     "commonParameters": {},
     "preProcessors": [],
     "postProcessors": [
      {
       "type": "assertion",
       "enable": true,
       "data": {
        "name": "status == 200",
        "subject": "httpCode",
        "comparison": "equal",
        "path": "",
        "value": "200"
       }
      },
      {
       "type": "assertion",
       "enable": true,
       "data": {
        "name": "$.access_token exists",
        "subject": "responseJson",
        "comparison": "exists",
        "path": "$.access_token",
        "value": "",
        "extractSettings": {
         "expression": "$.access_token"
        }
       }
      },
      {
       "type": "customScript",
       "enable": true,
       "data": "const tok = pm.response.json().access_token; pm.variables.set('accessToken', tok);\ntry { const p = JSON.parse(atob(tok.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))); pm.variables.set('projectId', p.fhir_project || ''); } catch (e) { pm.variables.set('projectId', ''); }\nconst base = '1.2.826.0.1.3680043.9.7777.' + Date.now() + (100 + Math.floor(Math.random() * 900));\npm.variables.set('studyUid', base + '.1'); pm.variables.set('seriesUid', base + '.1.1'); pm.variables.set('sop1', base + '.1.1.1'); pm.variables.set('sop2', base + '.1.1.2');\npm.variables.set('series2Uid', base + '.1.2'); pm.variables.set('sop3', base + '.1.2.1'); pm.variables.set('otherStudyUid', base + '.9');\npm.variables.set('pid', 'QA-' + Date.now());"
      }
     ],
     "auth": {
      "type": "noauth"
     },
     "securityScheme": {},
     "advancedSettings": {},
     "projectId": 1380475,
     "relatedId": 1998600,
     "creatorId": 552779,
     "editorId": 552779
    }
   },
