   "customHttpRequest": {
    "id": 988213,
    "name": "Không token -> 401 Thiếu bearer token",
    "path": "/dicomweb/studies",
    "method": "get",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "none"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 401",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "401"
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "pm.test(\"thông điệp + WWW-Authenticate\", () => { pm.expect(pm.response.json().error).to.eql('Thiếu bearer token'); pm.expect(pm.response.headers.get('WWW-Authenticate') || '').to.include('Bearer realm=\"dicomweb\"'); });"
     }
    ],
    "auth": {
     "type": "noauth"
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988213
  },
