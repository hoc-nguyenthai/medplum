{
 "slug": "conditional-write-flow",
 "name": "Ghi có điều kiện (If-None-Exist, PUT theo query)",
 "priority": 1,
 "steps": [
  {
   "name": "Đăng nhập admin project (auth /auth/login)",
   "endpointId": "auth-login",
   "method": "POST",
   "path": "{{authUrl}}/auth/login",
   "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}",
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.code exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "adm_code",
      "expression": "$.code",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "Đổi code lấy token admin (authorization_code)",
   "endpointId": "auth-token",
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "form": {
    "grant_type": "authorization_code",
    "code": "{{adm_code}}",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "bearerToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "POST Patient (ident mới)",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/Patient",
   "body": "{\"resourceType\": \"Patient\", \"identifier\": [{\"system\": \"urn:trivita:qa-mrn\", \"value\": \"cw-{{case_id}}-{{$timestamp}}\"}], \"name\": [{\"family\": \"Cond-{{$timestamp}}\", \"given\": [\"Qa\"]}]}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 201"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "patient_id",
      "expression": "$.id",
      "subject": "responseJson"
     }
    },
    {
     "type": "extractor",
     "data": {
      "variableName": "ident",
      "expression": "$.identifier[0].value",
      "subject": "responseJson"
     }
    },
    {
     "type": "extractor",
     "data": {
      "variableName": "v1",
      "expression": "$.meta.versionId",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "POST If-None-Exist (1 khớp) → 200, không tạo mới",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/Patient",
   "headers": {
    "If-None-Exist": "identifier=urn:trivita:qa-mrn|{{ident}}"
   },
   "body": "{\"resourceType\": \"Patient\", \"identifier\": [{\"system\": \"urn:trivita:qa-mrn\", \"value\": \"{{ident}}\"}], \"name\": [{\"family\": \"Cond-khac\", \"given\": [\"Qa\"]}]}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200",
    "$.id == {{patient_id}}"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('không có Location (không tạo mới)', () => pm.expect(pm.response.headers.get('Location')).to.eql(undefined));"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "POST cùng ident không điều kiện → 201 (tạo trùng)",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/Patient",
   "body": "{\"resourceType\": \"Patient\", \"identifier\": [{\"system\": \"urn:trivita:qa-mrn\", \"value\": \"{{ident}}\"}], \"name\": [{\"family\": \"Cond-trung\", \"given\": [\"Qa\"]}]}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 201"
   ],
   "custom": true
  },
  {
   "name": "POST If-None-Exist (2 khớp) → 412",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/Patient",
   "headers": {
    "If-None-Exist": "identifier=urn:trivita:qa-mrn|{{ident}}"
   },
   "body": "{\"resourceType\": \"Patient\", \"identifier\": [{\"system\": \"urn:trivita:qa-mrn\", \"value\": \"{{ident}}\"}], \"name\": [{\"family\": \"Cond-khac\", \"given\": [\"Qa\"]}]}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 412",
    "$.issue[0].code == conflict"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('thông điệp', () => pm.expect(pm.response.json().issue[0].details.text).to.include('Nhiều resource khớp If-None-Exist'));"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "PUT ?identifier (2 khớp) → 412",
   "endpointId": 47548495,
   "method": "PUT",
   "path": "/fhir/R4/Patient?identifier=urn:trivita:qa-mrn|{{ident}}",
   "body": "{\"resourceType\": \"Patient\", \"identifier\": [{\"system\": \"urn:trivita:qa-mrn\", \"value\": \"{{ident}}\"}], \"name\": [{\"family\": \"Cond-put\", \"given\": [\"Qa\"]}]}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 412"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('thông điệp', () => pm.expect(pm.response.json().issue[0].details.text).to.include('Nhiều resource khớp tiêu chí'));"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "PUT ?identifier (0 khớp) → 201 tạo mới",
   "endpointId": 47548495,
   "method": "PUT",
   "path": "/fhir/R4/Patient?identifier=urn:trivita:qa-mrn|{{ident}}-moi",
   "body": "{\"resourceType\": \"Patient\", \"identifier\": [{\"system\": \"urn:trivita:qa-mrn\", \"value\": \"{{ident}}-moi\"}], \"name\": [{\"family\": \"Cond-moi\", \"given\": [\"Qa\"]}]}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 201"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "patient2_id",
      "expression": "$.id",
      "subject": "responseJson"
     }
    },
    {
     "type": "extractor",
     "data": {
      "variableName": "v_new",
      "expression": "$.meta.versionId",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "PUT ?identifier (1 khớp) → 200 cập nhật cùng id",
   "endpointId": 47548495,
   "method": "PUT",
   "path": "/fhir/R4/Patient?identifier=urn:trivita:qa-mrn|{{ident}}-moi",
   "body": "{\"resourceType\": \"Patient\", \"identifier\": [{\"system\": \"urn:trivita:qa-mrn\", \"value\": \"{{ident}}-moi\"}], \"name\": [{\"family\": \"Cond-moi\", \"given\": [\"Qa\"]}], \"gender\": \"female\"}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200",
    "$.id == {{patient2_id}}",
    "$.gender == female"
   ]
  },
  {
   "name": "PUT ?identifier (1 khớp) + If-Match cũ → 412",
   "endpointId": 47548495,
   "method": "PUT",
   "path": "/fhir/R4/Patient?identifier=urn:trivita:qa-mrn|{{ident}}-moi",
   "headers": {
    "If-Match": "W/\"{{v_new}}\""
   },
   "body": "{\"resourceType\": \"Patient\", \"identifier\": [{\"system\": \"urn:trivita:qa-mrn\", \"value\": \"{{ident}}-moi\"}], \"name\": [{\"family\": \"Cond-moi\", \"given\": [\"Qa\"]}]}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 412"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('thông điệp', () => pm.expect(pm.response.json().issue[0].details.text).to.include('Phiên bản không khớp'));"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "PUT ?identifier (1 khớp) + id lệch → 400",
   "endpointId": 47548495,
   "method": "PUT",
   "path": "/fhir/R4/Patient?identifier=urn:trivita:qa-mrn|{{ident}}-moi",
   "body": "{\"resourceType\": \"Patient\", \"id\": \"00000000-0000-4000-8000-000000000000\", \"identifier\": [{\"system\": \"urn:trivita:qa-mrn\", \"value\": \"{{ident}}-moi\"}], \"name\": [{\"family\": \"Cond-moi\", \"given\": [\"Qa\"]}]}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 400"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('thông điệp', () => pm.expect(pm.response.json().issue[0].details.text).to.include('id trong body không khớp với resource tìm thấy'));"
     }
    }
   ],
   "custom": true
  }
 ]
}
