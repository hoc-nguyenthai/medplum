{
 "slug": "authz-matrix",
 "name": "Phân quyền theo scope token (RBAC + SMART)",
 "priority": 1,
 "steps": [
  {
   "name": "Đăng nhập admin project (auth /auth/login)",
   "endpointId": "auth-login",
   "method": "POST",
   "path": "{{authUrl}}/auth/login",
   "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}",
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.code exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "adm_code",
      "expression": "$.code",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "Đổi code lấy token admin (authorization_code)",
   "endpointId": "auth-token",
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "form": {
    "grant_type": "authorization_code",
    "code": "{{adm_code}}",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "adminToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "(setup) POST Patient bằng token admin",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/Patient",
   "body": "{\"resourceType\": \"Patient\", \"name\": [{\"family\": \"Az-{{case_id}}-{{$timestamp}}\", \"given\": [\"Qa\"]}], \"gender\": \"male\"}",
   "auth": "Bearer {{adminToken}}",
   "assertions": [
    "status == 201"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "patient_id",
      "expression": "$.id",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "Token theo scope của dòng dữ liệu",
   "endpointId": "auth-token",
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "form": {
    "grant_type": "client_credentials",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}",
    "{{scope_name}}": "{{token_scope}}"
   },
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "bearerToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "GET Patient/{id}",
   "endpointId": 47548498,
   "method": "GET",
   "path": "/fhir/R4/Patient/{{patient_id}}",
   "auth": "Bearer {{bearerToken}}",
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const e = pm.iterationData.get('st_get'); if (e) { pm.test('status == ' + e, () => pm.expect(String(pm.response.code)).to.eql(String(e))); }"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const m = pm.iterationData.get('msg_get'); if (m) { pm.test('thông điệp chứa: ' + m, () => pm.expect(pm.response.json().issue[0].details.text).to.include(m)); }"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "POST Patient",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/Patient",
   "body": "{\"resourceType\": \"Patient\", \"name\": [{\"family\": \"Az2-{{case_id}}-{{$timestamp}}\", \"given\": [\"Qa\"]}]}",
   "auth": "Bearer {{bearerToken}}",
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const e = pm.iterationData.get('st_post'); if (e) { pm.test('status == ' + e, () => pm.expect(String(pm.response.code)).to.eql(String(e))); }"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const m = pm.iterationData.get('msg_post'); if (m) { pm.test('thông điệp chứa: ' + m, () => pm.expect(pm.response.json().issue[0].details.text).to.include(m)); }"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "PUT Patient/{id}",
   "endpointId": 47548499,
   "method": "PUT",
   "path": "/fhir/R4/Patient/{{patient_id}}",
   "body": "{\"resourceType\": \"Patient\", \"id\": \"{{patient_id}}\", \"name\": [{\"family\": \"Az-{{case_id}}\", \"given\": [\"Qa\"]}], \"gender\": \"female\"}",
   "auth": "Bearer {{bearerToken}}",
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const e = pm.iterationData.get('st_put'); if (e) { pm.test('status == ' + e, () => pm.expect(String(pm.response.code)).to.eql(String(e))); }"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "POST Patient/{id}/$reindex (cần admin)",
   "endpointId": 47548518,
   "method": "POST",
   "path": "/fhir/R4/Patient/{{patient_id}}/$reindex",
   "auth": "Bearer {{bearerToken}}",
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const e = pm.iterationData.get('st_reindex'); if (e) { pm.test('status == ' + e, () => pm.expect(String(pm.response.code)).to.eql(String(e))); }"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const m = pm.iterationData.get('msg_reindex'); if (m) { pm.test('thông điệp chứa: ' + m, () => pm.expect(pm.response.json().issue[0].details.text).to.include(m)); }"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "DELETE Patient/{id}",
   "endpointId": 47548500,
   "method": "DELETE",
   "path": "/fhir/R4/Patient/{{patient_id}}",
   "auth": "Bearer {{bearerToken}}",
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const e = pm.iterationData.get('st_delete'); if (e) { pm.test('status == ' + e, () => pm.expect(String(pm.response.code)).to.eql(String(e))); }"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "(dọn) $expunge bằng token admin",
   "endpointId": 47548517,
   "method": "POST",
   "path": "/fhir/R4/Patient/{{patient_id}}/$expunge",
   "auth": "Bearer {{adminToken}}",
   "assertions": [
    "status == 200"
   ]
  }
 ]
}
