{
 "slug": "hub-lifecycle-stu3",
 "name": "Hub lifecycle STU3",
 "priority": 0,
 "steps": [
  {
   "name": "Chuẩn bị: lấy token client_credentials từ auth và đặt topic",
   "endpointId": 47548561,
   "method": "GET",
   "path": "/healthz",
   "assertions": [
    "status == 200"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "\nconst scope = pm.iterationData.get('oauth_scope') || 'fhircast/*';\nconst authUrl = pm.variables.get('authUrl') || pm.environment.get('authUrl');\nconst set = (k, v) => { try { pm.variables.set(k, v); } catch (e) {} try { pm.environment.set(k, v); } catch (e) {} };\nset('topic', 'qa-' + Date.now() + '-' + Math.floor(Math.random() * 1000000));\npm.sendRequest({\n  url: authUrl + '/oauth2/token', method: 'POST',\n  header: { 'Content-Type': 'application/x-www-form-urlencoded' },\n  body: { mode: 'urlencoded', urlencoded: [\n    { key: 'grant_type', value: 'client_credentials' },\n    { key: 'client_id', value: pm.variables.get('clientId') || pm.environment.get('clientId') },\n    { key: 'client_secret', value: pm.variables.get('clientSecret') || pm.environment.get('clientSecret') },\n    { key: 'scope', value: scope } ] }\n}, (err, res) => {\n  pm.test('token client_credentials 200', () => { pm.expect(err).to.eql(null); pm.expect(res.code).to.eql(200); });\n  if (!err && res.code === 200) { set('access_token', res.json().access_token); }\n});\n"
     }
    }
   ],
   "auth": "none"
  },
  {
   "name": "well-known công khai",
   "endpointId": 47548551,
   "method": "GET",
   "path": "/fhircast/STU3/.well-known/fhircast-configuration",
   "auth": "none",
   "assertions": [
    "status == 200"
   ]
  },
  {
   "name": "Đăng ký kênh websocket (JSON)",
   "endpointId": 47548550,
   "method": "POST",
   "path": "/fhircast/STU3",
   "auth": "Bearer {{access_token}}",
   "body": "{\"hub.channel.type\":\"websocket\",\"hub.mode\":\"subscribe\",\"hub.topic\":\"{{topic}}\",\"hub.events\":\"syncerror,heartbeat,userlogout,userhibernate,Patient-open,Patient-close,ImagingStudy-open,ImagingStudy-close,Encounter-open,Encounter-close,DiagnosticReport-open,DiagnosticReport-close,DiagnosticReport-select,DiagnosticReport-update\"}",
   "assertions": [
    "status == 202",
    "$['hub.channel.endpoint'] exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "channel_endpoint",
      "expression": "$['hub.channel.endpoint']",
      "subject": "responseJson"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "if (pm.response.code === 202) { pm.test('hub.channel.endpoint', () => pm.expect(pm.response.json()['hub.channel.endpoint']).to.match(/\\/ws\\/fhircast\\/[0-9a-f-]{36}$/)); }"
     }
    }
   ]
  },
  {
   "name": "GET ngữ cảnh khi chưa có",
   "endpointId": 47548552,
   "method": "GET",
   "path": "/fhircast/STU3/{{topic}}",
   "auth": "Bearer {{access_token}}",
   "assertions": [
    "status == 200"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('chưa có/đã đóng: context.type rỗng, context []', () => { const j = pm.response.json(); pm.expect(j['context.type']).to.eql(''); pm.expect(j.context).to.eql([]); });"
     }
    }
   ]
  },
  {
   "name": "Mở ngữ cảnh qua POST topic",
   "endpointId": 47548553,
   "method": "POST",
   "path": "/fhircast/STU3/{{topic}}",
   "auth": "Bearer {{access_token}}",
   "body": "{\"id\":\"qa-{{$timestamp}}\",\"timestamp\":\"2026-11-25T10:00:00.000Z\",\"event\":{\"hub.topic\":\"{{topic}}\",\"hub.event\":\"{{open_event}}\",\"context\":{{context_json}}}}",
   "assertions": [
    "status == 202",
    "$.success == true",
    "$.event.event['context.versionId'] exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "ctx_version",
      "expression": "$.event.event['context.versionId']",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "GET ngữ cảnh hiện tại ({{open_type}})",
   "endpointId": 47548552,
   "method": "GET",
   "path": "/fhircast/STU3/{{topic}}",
   "auth": "Bearer {{access_token}}",
   "assertions": [
    "status == 200",
    "$['context.type'] == {{open_type}}",
    "$['context.versionId'] == {{ctx_version}}"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('STU3: có mảng context', () => pm.expect(Array.isArray(pm.response.json().context)).to.eql(true));"
     }
    }
   ]
  },
  {
   "name": "POST {v} (không topic ở đường dẫn): heartbeat không đổi ngữ cảnh",
   "endpointId": 47548550,
   "method": "POST",
   "path": "/fhircast/STU3",
   "auth": "Bearer {{access_token}}",
   "body": "{\"id\":\"qa-{{$timestamp}}\",\"timestamp\":\"2026-11-25T10:00:00.000Z\",\"event\":{\"hub.topic\":\"{{topic}}\",\"hub.event\":\"heartbeat\",\"context\":[]}}",
   "assertions": [
    "status == 202",
    "$.success == true"
   ]
  },
  {
   "name": "Đóng ngữ cảnh",
   "endpointId": 47548553,
   "method": "POST",
   "path": "/fhircast/STU3/{{topic}}",
   "auth": "Bearer {{access_token}}",
   "body": "{\"id\":\"qa-{{$timestamp}}\",\"timestamp\":\"2026-11-25T10:00:00.000Z\",\"event\":{\"hub.topic\":\"{{topic}}\",\"hub.event\":\"{{close_event}}\",\"context\":{{context_json}}}}",
   "assertions": [
    "status == 202",
    "$.success == true",
    "$.event.event['context.versionId'] not exists"
   ]
  },
  {
   "name": "GET sau khi đóng",
   "endpointId": 47548552,
   "method": "GET",
   "path": "/fhircast/STU3/{{topic}}",
   "auth": "Bearer {{access_token}}",
   "assertions": [
    "status == 200"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('chưa có/đã đóng: context.type rỗng, context []', () => { const j = pm.response.json(); pm.expect(j['context.type']).to.eql(''); pm.expect(j.context).to.eql([]); });"
     }
    }
   ]
  },
  {
   "name": "Hủy đăng ký",
   "endpointId": 47548550,
   "method": "POST",
   "path": "/fhircast/STU3",
   "auth": "Bearer {{access_token}}",
   "body": "{\"hub.channel.type\":\"websocket\",\"hub.mode\":\"unsubscribe\",\"hub.topic\":\"{{topic}}\",\"hub.channel.endpoint\":\"{{channel_endpoint}}\"}",
   "assertions": [
    "status == 202",
    "$['hub.channel.endpoint'] exists"
   ]
  },
  {
   "name": "Hủy lần hai: endpoint không còn → 400 Invalid endpoint",
   "endpointId": 47548550,
   "method": "POST",
   "path": "/fhircast/STU3",
   "auth": "Bearer {{access_token}}",
   "body": "{\"hub.channel.type\":\"websocket\",\"hub.mode\":\"unsubscribe\",\"hub.topic\":\"{{topic}}\",\"hub.channel.endpoint\":\"{{channel_endpoint}}\"}",
   "assertions": [
    "status == 400"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('Invalid endpoint', () => pm.expect(pm.response.json().issue[0].details.text).to.eql('Invalid endpoint'));"
     }
    }
   ]
  }
 ]
}
