{"slug": "auth-scim-lifecycle", "name": "Auth | SCIM v2 Users: tạo, đọc, lọc, sửa, xóa", "priority": 2, "steps": [{"name": "Lấy token client_credentials", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "client_credentials", "client_id": "{{clientId}}", "client_secret": "{{clientSecret}}"}, "assertions": ["status == 200", "$.access_token exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "ccToken", "expression": "$.access_token", "subject": "responseJson"}}]}, {"name": "Đăng nhập admin (email + mật khẩu)", "endpointId": 47548452, "method": "POST", "path": "/auth/login", "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}", "auth": "none", "assertions": ["status == 200", "$.code exists", "$.login exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "loginId", "expression": "$.login", "subject": "responseJson"}}, {"type": "extractor", "data": {"variableName": "code", "expression": "$.code", "subject": "responseJson"}}]}, {"name": "Đổi code lấy token (authorization_code)", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "authorization_code", "code": "{{code}}", "client_id": "{{clientId}}", "client_secret": "{{clientSecret}}"}, "assertions": ["status == 200", "$.access_token exists", "$.token_type == Bearer"], "postProcessors": [{"type": "extractor", "data": {"variableName": "userToken", "expression": "$.access_token", "subject": "responseJson"}}]}, {"name": "Sinh userName/email duy nhất", "endpointId": 47548474, "method": "GET", "path": "/health/live", "auth": "none", "assertions": ["status == 200"], "postProcessors": [{"type": "customScript", "data": {"script": "const t = Date.now(); pm.variables.set('scimEmail', 'qa.scim.' + t + '@example.org');"}}]}, {"name": "POST /scim/v2/Users", "endpointId": 47548486, "method": "POST", "path": "/scim/v2/Users", "body": "{\"schemas\": [\"urn:ietf:params:scim:schemas:core:2.0:User\"], \"userName\": \"{{scimEmail}}\", \"name\": {\"givenName\": \"QA\", \"familyName\": \"Scim\"}, \"emails\": [{\"value\": \"{{scimEmail}}\"}], \"userType\": \"Practitioner\", \"active\": true}", "auth": "Bearer {{userToken}}", "assertions": ["status == 201", "$.id exists", "$.active == true"], "postProcessors": [{"type": "extractor", "data": {"variableName": "scimId", "expression": "$.id", "subject": "responseJson"}}, {"type": "customScript", "data": {"script": "pm.test('Location trỏ /scim/v2/Users/<id>', () => pm.expect(pm.response.headers.get('Location')).to.include('/scim/v2/Users/'));"}}]}, {"name": "GET /scim/v2/Users/{id}", "endpointId": 47548487, "method": "GET", "path": "/scim/v2/Users/{{scimId}}", "auth": "Bearer {{userToken}}", "assertions": ["status == 200", "$.id == {{scimId}}", "$.name.givenName == QA"]}, {"name": "GET list lọc userName eq", "endpointId": 47548485, "method": "GET", "path": "/scim/v2/Users", "query": {"filter": "userName eq \"{{scimEmail}}\""}, "auth": "Bearer {{userToken}}", "assertions": ["status == 200", "$.totalResults == 1", "$.Resources is array"]}, {"name": "PATCH replace name.givenName", "endpointId": 47548490, "method": "PATCH", "path": "/scim/v2/Users/{{scimId}}", "body": "{\"schemas\": [\"urn:ietf:params:scim:api:messages:2.0:PatchOp\"], \"Operations\": [{\"op\": \"replace\", \"path\": \"name.givenName\", \"value\": \"Updated\"}]}", "auth": "Bearer {{userToken}}", "assertions": ["status == 200"]}, {"name": "PUT thay thế user", "endpointId": 47548488, "method": "PUT", "path": "/scim/v2/Users/{{scimId}}", "body": "{\"schemas\": [\"urn:ietf:params:scim:schemas:core:2.0:User\"], \"userName\": \"{{scimEmail}}\", \"name\": {\"givenName\": \"Put\", \"familyName\": \"Scim\"}, \"emails\": [{\"value\": \"{{scimEmail}}\"}], \"active\": true}", "auth": "Bearer {{userToken}}", "assertions": ["status == 200"]}, {"name": "PATCH thiếu schema PatchOp → 400", "endpointId": 47548490, "method": "PATCH", "path": "/scim/v2/Users/{{scimId}}", "body": "{\"schemas\": [\"x\"], \"Operations\": []}", "auth": "Bearer {{userToken}}", "assertions": ["status == 400", "$.scimType == invalidSyntax"]}, {"name": "PATCH remove active → 400 mutability", "endpointId": 47548490, "method": "PATCH", "path": "/scim/v2/Users/{{scimId}}", "body": "{\"schemas\": [\"urn:ietf:params:scim:api:messages:2.0:PatchOp\"], \"Operations\": [{\"op\": \"remove\", \"path\": \"active\"}]}", "auth": "Bearer {{userToken}}", "assertions": ["status == 400", "$.scimType == mutability"]}, {"name": "DELETE user → 204", "endpointId": 47548489, "method": "DELETE", "path": "/scim/v2/Users/{{scimId}}", "auth": "Bearer {{userToken}}", "assertions": ["status == 204"]}, {"name": "GET sau khi xóa → 404 SCIM Error", "endpointId": 47548487, "method": "GET", "path": "/scim/v2/Users/{{scimId}}", "auth": "Bearer {{userToken}}", "assertions": ["status == 404", "$.detail == Not found"]}, {"name": "Không token → 401 + hai dòng WWW-Authenticate", "endpointId": 47548485, "method": "GET", "path": "/scim/v2/Users", "auth": "none", "assertions": ["status == 401"], "postProcessors": [{"type": "customScript", "data": {"script": "const h = pm.response.headers.get('WWW-Authenticate') || ''; pm.test('có Bearer realm=scim', () => pm.expect(h).to.include('Bearer realm=\"scim\"'));"}}]}, {"name": "Client không admin → 403", "endpointId": 47548485, "method": "GET", "path": "/scim/v2/Users", "auth": "Bearer {{ccToken}}", "assertions": ["status == 403"]}, {"name": "DELETE lần hai id đã xóa → 404", "endpointId": 47548489, "method": "DELETE", "path": "/scim/v2/Users/{{scimId}}", "auth": "Bearer {{userToken}}", "assertions": ["status == 404"]}]}
