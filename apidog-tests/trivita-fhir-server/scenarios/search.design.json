{
 "slug": "search",
 "name": "Tìm kiếm Patient: lọc, sắp xếp, phân trang, lỗi",
 "priority": 1,
 "steps": [
  {
   "name": "Đăng nhập admin project (auth /auth/login)",
   "endpointId": "auth-login",
   "method": "POST",
   "path": "{{authUrl}}/auth/login",
   "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}",
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.code exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "adm_code",
      "expression": "$.code",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "Đổi code lấy token admin (authorization_code)",
   "endpointId": "auth-token",
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "form": {
    "grant_type": "authorization_code",
    "code": "{{adm_code}}",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "bearerToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "(setup) Patient 1 (male, 1980-01-01)",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/Patient",
   "body": "{\"resourceType\": \"Patient\", \"name\": [{\"family\": \"Qa-{{case_id}}-{{$timestamp}}\", \"given\": [\"Qa\"]}], \"gender\": \"male\", \"birthDate\": \"1980-01-01\"}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 201",
    "$.id exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "patient_id",
      "expression": "$.id",
      "subject": "responseJson"
     }
    },
    {
     "type": "extractor",
     "data": {
      "variableName": "marker",
      "expression": "$.name[0].family",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "(setup) Patient 2 (female, 1990-06-15)",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/Patient",
   "body": "{\"resourceType\": \"Patient\", \"name\": [{\"family\": \"{{marker}}\", \"given\": [\"Qa\"]}], \"gender\": \"female\", \"birthDate\": \"1990-06-15\"}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 201",
    "$.id exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "p2_id",
      "expression": "$.id",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "(setup) Patient 3 (female, 2000-12-31)",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/Patient",
   "body": "{\"resourceType\": \"Patient\", \"name\": [{\"family\": \"{{marker}}\", \"given\": [\"Qa\"]}], \"gender\": \"female\", \"birthDate\": \"2000-12-31\"}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 201",
    "$.id exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "p3_id",
      "expression": "$.id",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "GET /Patient?family={marker}{query}",
   "endpointId": 47548494,
   "method": "GET",
   "path": "/fhir/R4/Patient?family={{marker}}{{query}}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == {{expected_status}}"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "const code = pm.iterationData.get('expected_code'); const msg = pm.iterationData.get('expected_message'); let b = {}; try { b = pm.response.json(); } catch (x) {} const issue = (b.issue && b.issue[0]) || {}; const text = (issue.details && issue.details.text) || (b.errors && b.errors[0] && b.errors[0].message) || ''; if (code) { pm.test('issue.code == ' + code, () => pm.expect(issue.code).to.eql(code)); } if (msg) { pm.test('thông điệp chứa: ' + msg, () => pm.expect(text).to.include(msg)); }"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const g = k => pm.iterationData.get(k); const b = pm.response.json(); const n = (b.entry || []).length; const has = k => g(k) !== undefined && g(k) !== ''; if (has('expected_entries')) { pm.test('số entry == ' + g('expected_entries'), () => pm.expect(n).to.eql(Number(g('expected_entries')))); } if (has('expected_total')) { pm.test('total == ' + g('expected_total'), () => pm.expect(b.total).to.eql(Number(g('expected_total')))); } const rel = r => (b.link || []).some(l => l.relation === r); if (has('expected_next')) { pm.test('link next == ' + g('expected_next'), () => pm.expect(rel('next')).to.eql(g('expected_next') === 'true')); } if (has('expected_prev')) { pm.test('link previous == ' + g('expected_prev'), () => pm.expect(rel('previous')).to.eql(g('expected_prev') === 'true')); } if (has('expected_first_birthdate')) { pm.test('entry[0].birthDate == ' + g('expected_first_birthdate'), () => pm.expect(b.entry[0].resource.birthDate).to.eql(g('expected_first_birthdate'))); }"
     }
    }
   ],
   "custom": true
  }
 ]
}
