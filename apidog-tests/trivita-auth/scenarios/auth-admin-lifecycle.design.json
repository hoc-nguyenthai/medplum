{"slug": "auth-admin-lifecycle", "name": "Auth | Admin project: setting/secret/site/client/rotate-secret/invite/member/delete", "priority": 1, "steps": [{"name": "Đăng nhập admin (email + mật khẩu)", "endpointId": 47548452, "method": "POST", "path": "/auth/login", "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}", "auth": "none", "assertions": ["status == 200", "$.code exists", "$.login exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "loginId", "expression": "$.login", "subject": "responseJson"}}, {"type": "extractor", "data": {"variableName": "code", "expression": "$.code", "subject": "responseJson"}}]}, {"name": "Đổi code lấy token (authorization_code)", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "authorization_code", "code": "{{code}}", "client_id": "{{clientId}}", "client_secret": "{{clientSecret}}"}, "assertions": ["status == 200", "$.access_token exists", "$.token_type == Bearer"], "postProcessors": [{"type": "extractor", "data": {"variableName": "userToken", "expression": "$.access_token", "subject": "responseJson"}}]}, {"name": "Đọc project; sinh email/tên duy nhất cho các bước sau", "endpointId": 47548427, "method": "GET", "path": "/admin/projects/{{projectId}}", "auth": "Bearer {{userToken}}", "assertions": ["status == 200", "$.project.id == {{projectId}}"], "postProcessors": [{"type": "customScript", "data": {"script": "const t = Date.now(); pm.variables.set('invEmail', 'qa.inv.' + t + '@example.org'); pm.variables.set('invEmail2', 'qa.inv2.' + t + '@example.org');"}}]}, {"name": "Đặt setting appName", "endpointId": 47548439, "method": "POST", "path": "/admin/projects/{{projectId}}/settings", "body": "[{\"name\": \"appName\", \"valueString\": \"QA App\"}]", "auth": "Bearer {{userToken}}", "assertions": ["status == 200", "$.project.setting[0].name == appName"]}, {"name": "Đặt secret qaSecret", "endpointId": 47548438, "method": "POST", "path": "/admin/projects/{{projectId}}/secrets", "body": "[{\"name\": \"qaSecret\", \"valueString\": \"s3cr3t-value-1\"}]", "auth": "Bearer {{userToken}}", "assertions": ["status == 200"]}, {"name": "Đọc project: secret bị che", "endpointId": 47548427, "method": "GET", "path": "/admin/projects/{{projectId}}", "auth": "Bearer {{userToken}}", "assertions": ["status == 200", "$.project.secret[0].name == qaSecret", "$.project.secret[0].valueString == ********"]}, {"name": "Đặt site", "endpointId": 47548440, "method": "POST", "path": "/admin/projects/{{projectId}}/sites", "body": "[{\"name\": \"qa-site\", \"domain\": [\"qa.example.org\"]}]", "auth": "Bearer {{userToken}}", "assertions": ["status == 200"]}, {"name": "Tạo client client_credentials", "endpointId": 47548428, "method": "POST", "path": "/admin/projects/{{projectId}}/client", "body": "{\"name\": \"QA lifecycle client {{$timestamp}}\", \"grantType\": [\"client_credentials\"]}", "auth": "Bearer {{userToken}}", "assertions": ["status == 201", "$.secret exists", "$.id exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "newClientId", "expression": "$.id", "subject": "responseJson"}}, {"type": "extractor", "data": {"variableName": "newClientSecret", "expression": "$.secret", "subject": "responseJson"}}]}, {"name": "Token của client mới", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "client_credentials", "client_id": "{{newClientId}}", "client_secret": "{{newClientSecret}}"}, "assertions": ["status == 200", "$.access_token exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "newCcToken", "expression": "$.access_token", "subject": "responseJson"}}]}, {"name": "Xoay secret client", "endpointId": 47548429, "method": "POST", "path": "/admin/projects/{{projectId}}/client/{{newClientId}}/rotate-secret", "body": "{}", "auth": "Bearer {{userToken}}", "assertions": ["status == 200", "$.clientSecret exists", "$.retiring == true"], "postProcessors": [{"type": "extractor", "data": {"variableName": "rotatedSecret", "expression": "$.clientSecret", "subject": "responseJson"}}]}, {"name": "Secret cũ còn dùng được khi retiring", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "client_credentials", "client_id": "{{newClientId}}", "client_secret": "{{newClientSecret}}"}, "assertions": ["status == 200", "$.access_token exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "oldOk", "expression": "$.access_token", "subject": "responseJson"}}]}, {"name": "Secret mới dùng được", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "client_credentials", "client_id": "{{newClientId}}", "client_secret": "{{rotatedSecret}}"}, "assertions": ["status == 200", "$.access_token exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "newOk", "expression": "$.access_token", "subject": "responseJson"}}]}, {"name": "Xoay secret trùng secret hiện tại → 400", "endpointId": 47548429, "method": "POST", "path": "/admin/projects/{{projectId}}/client/{{newClientId}}/rotate-secret", "body": "{\"secret\": \"{{rotatedSecret}}\"}", "auth": "Bearer {{userToken}}", "assertions": ["status == 400", "$.issue[0].details.text == New secret must differ from the current secret"]}, {"name": "Bỏ secret cũ (retireOnly)", "endpointId": 47548429, "method": "POST", "path": "/admin/projects/{{projectId}}/client/{{newClientId}}/rotate-secret", "body": "{\"retireOnly\": true}", "auth": "Bearer {{userToken}}", "assertions": ["status == 200", "$.retiring == false"]}, {"name": "Secret cũ hết hiệu lực → 400 Invalid secret", "endpointId": 47548482, "method": "POST", "path": "/oauth2/token", "form": {"grant_type": "client_credentials", "client_id": "{{newClientId}}", "client_secret": "{{newClientSecret}}"}, "assertions": ["status == 400", "$.error == invalid_request", "$.error_description == Invalid secret"]}, {"name": "Mời user Practitioner (không gửi thư)", "endpointId": 47548431, "method": "POST", "path": "/admin/projects/{{projectId}}/invite", "body": "{\"resourceType\": \"Practitioner\", \"firstName\": \"QA\", \"lastName\": \"Invite\", \"email\": \"{{invEmail}}\", \"sendEmail\": false, \"scope\": \"project\", \"password\": \"Qa-Invite-2026-pw1\"}", "auth": "Bearer {{userToken}}", "assertions": ["status == 200", "$.resourceType == ProjectMembership", "$.id exists"], "postProcessors": [{"type": "extractor", "data": {"variableName": "membershipId", "expression": "$.id", "subject": "responseJson"}}]}, {"name": "Mời lại cùng email → 409", "endpointId": 47548431, "method": "POST", "path": "/admin/projects/{{projectId}}/invite", "body": "{\"resourceType\": \"Practitioner\", \"firstName\": \"QA\", \"lastName\": \"Invite\", \"email\": \"{{invEmail}}\", \"sendEmail\": false, \"scope\": \"project\"}", "auth": "Bearer {{userToken}}", "assertions": ["status == 409", "$.issue[0].details.text == User is already a member of this project"]}, {"name": "Đọc membership; dựng body tắt active", "endpointId": 47548432, "method": "GET", "path": "/admin/projects/{{projectId}}/members/{{membershipId}}", "auth": "Bearer {{userToken}}", "assertions": ["status == 200", "$.id == {{membershipId}}"], "postProcessors": [{"type": "customScript", "data": {"script": "const m = pm.response.json(); m.active = false; pm.variables.set('memberJson', JSON.stringify(m));"}}]}, {"name": "Tắt membership (active=false)", "endpointId": 47548433, "method": "POST", "path": "/admin/projects/{{projectId}}/members/{{membershipId}}", "body": "{{memberJson}}", "auth": "Bearer {{userToken}}", "assertions": ["status == 200", "$.active == false"]}, {"name": "Admin đặt mật khẩu cho user của project", "endpointId": 47548426, "method": "POST", "path": "/admin/projects/setpassword", "body": "{\"email\": \"{{invEmail}}\", \"password\": \"Qa-Invite-2026-pw2\"}", "auth": "Bearer {{userToken}}", "assertions": ["status == 200"]}, {"name": "Đổi email của member", "endpointId": 47548437, "method": "POST", "path": "/admin/projects/{{projectId}}/members/{{membershipId}}/update-email", "body": "{\"email\": \"{{invEmail2}}\"}", "auth": "Bearer {{userToken}}", "assertions": ["status == 200"]}, {"name": "Đổi email lần nữa về chính email đó → 400", "endpointId": 47548437, "method": "POST", "path": "/admin/projects/{{projectId}}/members/{{membershipId}}/update-email", "body": "{\"email\": \"{{invEmail2}}\"}", "auth": "Bearer {{userToken}}", "assertions": ["status == 400", "$.issue[0].details.text == New email is the same as the current email"]}, {"name": "Xóa membership", "endpointId": 47548434, "method": "DELETE", "path": "/admin/projects/{{projectId}}/members/{{membershipId}}", "auth": "Bearer {{userToken}}", "assertions": ["status == 200"]}, {"name": "Đọc membership đã xóa → 403 chung", "endpointId": 47548432, "method": "GET", "path": "/admin/projects/{{projectId}}/members/{{membershipId}}", "auth": "Bearer {{userToken}}", "assertions": ["status == 403", "$.issue[0].details.text == Forbidden"]}, {"name": "Xóa lần hai → 403 chung", "endpointId": 47548434, "method": "DELETE", "path": "/admin/projects/{{projectId}}/members/{{membershipId}}", "auth": "Bearer {{userToken}}", "assertions": ["status == 403"]}, {"name": "Trả setting/secret/site về rỗng", "endpointId": 47548439, "method": "POST", "path": "/admin/projects/{{projectId}}/settings", "body": "[]", "auth": "Bearer {{userToken}}", "assertions": ["status == 200"]}, {"name": "Xóa secret", "endpointId": 47548438, "method": "POST", "path": "/admin/projects/{{projectId}}/secrets", "body": "[]", "auth": "Bearer {{userToken}}", "assertions": ["status == 200"]}, {"name": "Xóa site", "endpointId": 47548440, "method": "POST", "path": "/admin/projects/{{projectId}}/sites", "body": "[]", "auth": "Bearer {{userToken}}", "assertions": ["status == 200"]}]}
