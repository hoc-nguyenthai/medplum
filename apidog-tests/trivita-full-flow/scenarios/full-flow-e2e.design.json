{
 "slug": "full-flow-e2e",
 "name": "Full flow: auth → FHIR → $export → DICOM → FHIRcast → dọn dẹp",
 "priority": 0,
 "steps": [
  {
   "name": "auth: GET /health/live",
   "endpointId": 9100000,
   "method": "GET",
   "path": "{{authUrl}}/health/live",
   "auth": "none",
   "custom": true,
   "assertions": [
    "status == 200"
   ]
  },
  {
   "name": "fhir-server: GET /healthz",
   "endpointId": 9100001,
   "method": "GET",
   "path": "{{fhirUrl}}/healthz",
   "auth": "none",
   "custom": true,
   "assertions": [
    "status == 200"
   ]
  },
  {
   "name": "dicomweb: GET /healthz",
   "endpointId": 9100002,
   "method": "GET",
   "path": "{{dicomUrl}}/healthz",
   "auth": "none",
   "custom": true,
   "assertions": [
    "status == 200"
   ]
  },
  {
   "name": "ws-gateway: GET /healthz",
   "endpointId": 9100003,
   "method": "GET",
   "path": "{{wsUrl}}/healthz",
   "auth": "none",
   "custom": true,
   "assertions": [
    "status == 200"
   ]
  },
  {
   "name": "Lấy token client_credentials (auth)",
   "endpointId": 9100004,
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "auth": "none",
   "custom": true,
   "form": {
    "grant_type": "client_credentials",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "accessToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const base = '1.2.826.0.1.3680043.9.7777.' + Date.now() + (100 + Math.floor(Math.random() * 900));\npm.variables.set('studyUid', base + '.1'); pm.variables.set('seriesUid', base + '.1.1'); pm.variables.set('sop', base + '.1.1.1');\npm.variables.set('pid', 'QA-FF-' + Date.now());\npm.variables.set('topic', 'qa-ff-' + Date.now() + '-' + Math.floor(Math.random() * 1000000));"
     }
    }
   ]
  },
  {
   "name": "auth: POST /oauth2/introspect token vừa cấp -> active",
   "endpointId": 9100005,
   "method": "POST",
   "path": "{{authUrl}}/oauth2/introspect",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "form": {
    "token": "{{accessToken}}"
   },
   "assertions": [
    "status == 200",
    "$.active == true",
    "$.client_id == {{clientId}}"
   ]
  },
  {
   "name": "auth: GET /auth/me của ClientApplication",
   "endpointId": 9100006,
   "method": "GET",
   "path": "{{authUrl}}/auth/me",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 200",
    "$.project.id exists"
   ]
  },
  {
   "name": "fhir: POST Patient",
   "endpointId": 9100007,
   "method": "POST",
   "path": "{{fhirUrl}}/fhir/R4/Patient",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "body": "{\"resourceType\": \"Patient\", \"identifier\": [{\"system\": \"urn:trivita:qa-mrn\", \"value\": \"{{pid}}\"}], \"name\": [{\"family\": \"FullFlowQa\", \"given\": [\"Qa\"]}], \"gender\": \"male\"}",
   "assertions": [
    "status == 201",
    "$.resourceType == Patient",
    "$.id exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "patient_id",
      "expression": "$.id",
      "subject": "responseJson"
     }
    },
    {
     "type": "extractor",
     "data": {
      "variableName": "v1",
      "expression": "$.meta.versionId",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "fhir: GET Patient/{id}",
   "endpointId": 9100008,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/Patient/{{patient_id}}",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 200",
    "$.id == {{patient_id}}",
    "$.meta.versionId == {{v1}}"
   ]
  },
  {
   "name": "fhir: tìm Patient theo identifier -> đúng 1",
   "endpointId": 9100009,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/Patient",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "query": {
    "identifier": "urn:trivita:qa-mrn|{{pid}}"
   },
   "assertions": [
    "status == 200",
    "$.resourceType == Bundle"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"đúng 1 entry\", () => { pm.expect(pm.response.json().entry.length).to.eql(1); });"
     }
    }
   ]
  },
  {
   "name": "fhir: PUT Patient/{id} đổi gender (phiên bản 2)",
   "endpointId": 9100010,
   "method": "PUT",
   "path": "{{fhirUrl}}/fhir/R4/Patient/{{patient_id}}",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "body": "{\"resourceType\": \"Patient\", \"id\": \"{{patient_id}}\", \"identifier\": [{\"system\": \"urn:trivita:qa-mrn\", \"value\": \"{{pid}}\"}], \"name\": [{\"family\": \"FullFlowQa\", \"given\": [\"Qa\"]}], \"gender\": \"female\"}",
   "assertions": [
    "status == 200",
    "$.gender == female"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"versionId đổi\", () => { pm.expect(pm.response.json().meta.versionId).to.not.eql(pm.variables.get('v1')); });"
     }
    }
   ]
  },
  {
   "name": "fhir: GET Patient/{id}/_history -> 2 phiên bản",
   "endpointId": 9100011,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/Patient/{{patient_id}}/_history",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 200",
    "$.type == history"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"2 entry\", () => { pm.expect(pm.response.json().entry.length).to.eql(2); });"
     }
    }
   ]
  },
  {
   "name": "fhir: POST Observation gắn Patient",
   "endpointId": 9100012,
   "method": "POST",
   "path": "{{fhirUrl}}/fhir/R4/Observation",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "body": "{\"resourceType\": \"Observation\", \"status\": \"final\", \"code\": {\"text\": \"qa full flow\"}, \"subject\": {\"reference\": \"Patient/{{patient_id}}\"}, \"valueString\": \"ok\"}",
   "assertions": [
    "status == 201",
    "$.id exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "obs_id",
      "expression": "$.id",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "fhir: GET Patient/{id}/$everything có Patient + Observation",
   "endpointId": 9100013,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/Patient/{{patient_id}}/$everything",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 200",
    "$.resourceType == Bundle"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"có cả Patient và Observation\", () => { const ty = (pm.response.json().entry || []).map(e => e.resource.resourceType); pm.expect(ty).to.include('Patient'); pm.expect(ty).to.include('Observation'); });"
     }
    }
   ]
  },
  {
   "name": "fhir: GET $export (Prefer: respond-async) -> 202",
   "endpointId": 9100014,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/$export",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "query": {
    "_type": "Patient",
    "_outputFormat": "ndjson"
   },
   "headers": {
    "Prefer": "respond-async"
   },
   "assertions": [
    "status == 202"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"Content-Location có id job\", () => { const m = (pm.response.headers.get('Content-Location') || '').match(/bulkdata\\/([^\\/]+)\\/status/); pm.expect(m).to.not.eql(null); pm.variables.set('job_id', m[1]); });"
     }
    }
   ]
  },
  {
   "name": "fhir: GET bulkdata/{id}/status (lần 1)",
   "endpointId": 9100015,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/bulkdata/{{job_id}}/status",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"202 hoặc 200\", () => { pm.expect([200, 202]).to.include(pm.response.code); });"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const t0 = Date.now(); while (Date.now() - t0 < 3000) {}"
     }
    }
   ]
  },
  {
   "name": "fhir: GET bulkdata/{id}/status (lần 2)",
   "endpointId": 9100016,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/bulkdata/{{job_id}}/status",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"202 hoặc 200\", () => { pm.expect([200, 202]).to.include(pm.response.code); });"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const t0 = Date.now(); while (Date.now() - t0 < 3000) {}"
     }
    }
   ]
  },
  {
   "name": "fhir: GET bulkdata/{id}/status (lần 3)",
   "endpointId": 9100017,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/bulkdata/{{job_id}}/status",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"202 hoặc 200\", () => { pm.expect([200, 202]).to.include(pm.response.code); });"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const t0 = Date.now(); while (Date.now() - t0 < 3000) {}"
     }
    }
   ]
  },
  {
   "name": "fhir: GET bulkdata/{id}/status -> 200 manifest (do fhir-worker chạy)",
   "endpointId": 9100018,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/bulkdata/{{job_id}}/status",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 200",
    "$.output is array"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"có file output\", () => { const u = (pm.response.json().output || [])[0]; pm.expect(u).to.not.eql(undefined); pm.variables.set('bin_id', String(u.url).split('/').pop()); });"
     }
    }
   ]
  },
  {
   "name": "fhir: GET Binary/{id} (ndjson từ kho dùng chung)",
   "endpointId": 9100019,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/Binary/{{bin_id}}",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "headers": {
    "Accept": "application/fhir+ndjson"
   },
   "assertions": [
    "status == 200"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"ndjson chứa Patient\", () => { pm.expect(pm.response.text()).to.include('\"resourceType\":\"Patient\"'); });"
     }
    }
   ]
  },
  {
   "name": "fhir: DELETE bulkdata/{id}/status (dọn job)",
   "endpointId": 9100020,
   "method": "DELETE",
   "path": "{{fhirUrl}}/fhir/R4/bulkdata/{{job_id}}/status",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 202"
   ]
  },
  {
   "name": "dicomweb: STOW-RS dạng metadata 1 instance (200)",
   "endpointId": 9100021,
   "method": "POST",
   "path": "{{dicomUrl}}/dicomweb/studies",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "headers": {
    "Content-Type": "multipart/related; type=\"application/dicom+json\"; boundary=qa-ff-bnd"
   },
   "body": "--qa-ff-bnd\r\nContent-Type: application/dicom+json\r\n\r\n[{\"00080016\":{\"vr\":\"UI\",\"Value\":[\"1.2.840.10008.5.1.4.1.1.2\"]},\"00080018\":{\"vr\":\"UI\",\"Value\":[\"{{sop}}\"]},\"00080060\":{\"vr\":\"CS\",\"Value\":[\"CT\"]},\"00080020\":{\"vr\":\"DA\",\"Value\":[\"20240102\"]},\"00100010\":{\"vr\":\"PN\",\"Value\":[{\"Alphabetic\":\"Qa^FullFlow\"}]},\"00100020\":{\"vr\":\"LO\",\"Value\":[\"{{pid}}\"]},\"0020000D\":{\"vr\":\"UI\",\"Value\":[\"{{studyUid}}\"]},\"0020000E\":{\"vr\":\"UI\",\"Value\":[\"{{seriesUid}}\"]},\"00280002\":{\"vr\":\"US\",\"Value\":[1]},\"00280004\":{\"vr\":\"CS\",\"Value\":[\"MONOCHROME2\"]},\"00280008\":{\"vr\":\"IS\",\"Value\":[\"1\"]},\"00280010\":{\"vr\":\"US\",\"Value\":[2]},\"00280011\":{\"vr\":\"US\",\"Value\":[2]},\"00280100\":{\"vr\":\"US\",\"Value\":[8]},\"00280101\":{\"vr\":\"US\",\"Value\":[8]},\"00280102\":{\"vr\":\"US\",\"Value\":[7]},\"00280103\":{\"vr\":\"US\",\"Value\":[0]},\"7FE00010\":{\"vr\":\"OB\",\"BulkDataURI\":\"urn:qa:ff-px\"}}]\r\n--qa-ff-bnd\r\nContent-Location: urn:qa:ff-px\r\nContent-Type: application/octet-stream\r\n\r\nFFLW\r\n--qa-ff-bnd--\r\n",
   "bodyType": "raw",
   "assertions": [
    "status == 200"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"ReferencedSOPSequence 1 phần tử, không Failed\", () => { const j = pm.response.json(); pm.expect(j['00081199'].Value.length).to.eql(1); pm.expect(j['00081198']).to.eql(undefined); });"
     }
    }
   ]
  },
  {
   "name": "dicomweb: QIDO-RS study theo StudyInstanceUID -> 1",
   "endpointId": 9100022,
   "method": "GET",
   "path": "{{dicomUrl}}/dicomweb/studies",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "query": {
    "StudyInstanceUID": "{{studyUid}}"
   },
   "assertions": [
    "status == 200"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"đúng 1 study\", () => { const j = pm.response.json(); pm.expect(j.length).to.eql(1); pm.expect(j[0]['0020000D'].Value[0]).to.eql(pm.variables.get('studyUid')); });"
     }
    }
   ]
  },
  {
   "name": "dicomweb: WADO-RS metadata instance",
   "endpointId": 9100023,
   "method": "GET",
   "path": "{{dicomUrl}}/dicomweb/studies/{{studyUid}}/series/{{seriesUid}}/instances/{{sop}}/metadata",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 200"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"có SOPInstanceUID\", () => { pm.expect(pm.response.text()).to.include(pm.variables.get('sop')); });"
     }
    }
   ]
  },
  {
   "name": "dicomweb: WADO-RS tải instance (Part 10)",
   "endpointId": 9100024,
   "method": "GET",
   "path": "{{dicomUrl}}/dicomweb/studies/{{studyUid}}/series/{{seriesUid}}/instances/{{sop}}",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 200"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"multipart/related, có DICM\", () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('multipart/related'); pm.expect(pm.response.text()).to.include('DICM'); });"
     }
    }
   ]
  },
  {
   "name": "dicomweb: WADO-RS frame 1 đúng byte đã STOW",
   "endpointId": 9100025,
   "method": "GET",
   "path": "{{dicomUrl}}/dicomweb/studies/{{studyUid}}/series/{{seriesUid}}/instances/{{sop}}/frames/1",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 200"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"body chứa FFLW\", () => { pm.expect(pm.response.text()).to.include('FFLW'); });"
     }
    }
   ]
  },
  {
   "name": "fhir: GET DicomStudy thấy study do dicomweb ghi (schema dùng chung)",
   "endpointId": 9100026,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/DicomStudy",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "query": {
    "_count": "50"
   },
   "assertions": [
    "status == 200"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"study có trong kết quả\", () => { pm.expect(pm.response.text()).to.include(pm.variables.get('studyUid')); });"
     }
    }
   ]
  },
  {
   "name": "auth: token client_credentials scope fhircast/* cho ws-gateway",
   "endpointId": 9100027,
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "auth": "none",
   "custom": true,
   "form": {
    "grant_type": "client_credentials",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}",
    "scope": "fhircast/*"
   },
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "wsToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "ws-gateway: GET .well-known/fhircast-configuration (công khai)",
   "endpointId": 9100028,
   "method": "GET",
   "path": "{{wsUrl}}/fhircast/STU3/.well-known/fhircast-configuration",
   "auth": "none",
   "custom": true,
   "assertions": [
    "status == 200"
   ]
  },
  {
   "name": "ws-gateway: subscribe websocket (STU3)",
   "endpointId": 9100029,
   "method": "POST",
   "path": "{{wsUrl}}/fhircast/STU3",
   "auth": "Bearer {{wsToken}}",
   "custom": true,
   "body": "{\"hub.channel.type\": \"websocket\", \"hub.mode\": \"subscribe\", \"hub.topic\": \"{{topic}}\", \"hub.events\": \"Patient-open,Patient-close\"}",
   "assertions": [
    "status == 202",
    "$['hub.channel.endpoint'] exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "channel_endpoint",
      "expression": "$['hub.channel.endpoint']",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "ws-gateway: mở ngữ cảnh Patient-open theo Patient vừa tạo",
   "endpointId": 9100030,
   "method": "POST",
   "path": "{{wsUrl}}/fhircast/STU3/{{topic}}",
   "auth": "Bearer {{wsToken}}",
   "custom": true,
   "body": "{\"id\":\"qa-ff-{{$timestamp}}\",\"timestamp\":\"2026-11-25T10:00:00.000Z\",\"event\":{\"hub.topic\":\"{{topic}}\",\"hub.event\":\"Patient-open\",\"context\":[{\"key\":\"patient\",\"resource\":{\"resourceType\":\"Patient\",\"id\":\"{{patient_id}}\"}}]}}",
   "assertions": [
    "status == 202",
    "$.success == true"
   ]
  },
  {
   "name": "ws-gateway: GET ngữ cảnh hiện tại = Patient",
   "endpointId": 9100031,
   "method": "GET",
   "path": "{{wsUrl}}/fhircast/STU3/{{topic}}",
   "auth": "Bearer {{wsToken}}",
   "custom": true,
   "assertions": [
    "status == 200"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test(\"context.type\", () => { pm.expect(pm.response.json()['context.type']).to.eql('Patient'); });"
     }
    }
   ]
  },
  {
   "name": "ws-gateway: đóng ngữ cảnh Patient-close",
   "endpointId": 9100032,
   "method": "POST",
   "path": "{{wsUrl}}/fhircast/STU3/{{topic}}",
   "auth": "Bearer {{wsToken}}",
   "custom": true,
   "body": "{\"id\":\"qa-ff-{{$timestamp}}\",\"timestamp\":\"2026-11-25T10:00:00.000Z\",\"event\":{\"hub.topic\":\"{{topic}}\",\"hub.event\":\"Patient-close\",\"context\":[{\"key\":\"patient\",\"resource\":{\"resourceType\":\"Patient\",\"id\":\"{{patient_id}}\"}}]}}",
   "assertions": [
    "status == 202",
    "$.success == true"
   ]
  },
  {
   "name": "ws-gateway: unsubscribe",
   "endpointId": 9100033,
   "method": "POST",
   "path": "{{wsUrl}}/fhircast/STU3",
   "auth": "Bearer {{wsToken}}",
   "custom": true,
   "body": "{\"hub.channel.type\":\"websocket\",\"hub.mode\":\"unsubscribe\",\"hub.topic\":\"{{topic}}\",\"hub.channel.endpoint\":\"{{channel_endpoint}}\"}",
   "assertions": [
    "status == 202"
   ]
  },
  {
   "name": "fhir: DELETE Observation",
   "endpointId": 9100034,
   "method": "DELETE",
   "path": "{{fhirUrl}}/fhir/R4/Observation/{{obs_id}}",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 204"
   ]
  },
  {
   "name": "fhir: DELETE Patient (xóa mềm)",
   "endpointId": 9100035,
   "method": "DELETE",
   "path": "{{fhirUrl}}/fhir/R4/Patient/{{patient_id}}",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 204"
   ]
  },
  {
   "name": "fhir: GET Patient đã xóa -> 410",
   "endpointId": 9100036,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/Patient/{{patient_id}}",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 410",
    "$.issue[0].code == deleted"
   ]
  },
  {
   "name": "auth: đăng nhập admin project (để $expunge)",
   "endpointId": 9100037,
   "method": "POST",
   "path": "{{authUrl}}/auth/login",
   "auth": "none",
   "custom": true,
   "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}",
   "assertions": [
    "status == 200",
    "$.code exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "adm_code",
      "expression": "$.code",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "auth: đổi code lấy token admin",
   "endpointId": 9100038,
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "auth": "none",
   "custom": true,
   "form": {
    "grant_type": "authorization_code",
    "code": "{{adm_code}}",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "adminToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "fhir: POST Patient/{id}/$expunge (xóa vĩnh viễn)",
   "endpointId": 9100039,
   "method": "POST",
   "path": "{{fhirUrl}}/fhir/R4/Patient/{{patient_id}}/$expunge",
   "auth": "Bearer {{adminToken}}",
   "custom": true,
   "assertions": [
    "status == 200"
   ]
  },
  {
   "name": "fhir: POST Observation/{id}/$expunge",
   "endpointId": 9100040,
   "method": "POST",
   "path": "{{fhirUrl}}/fhir/R4/Observation/{{obs_id}}/$expunge",
   "auth": "Bearer {{adminToken}}",
   "custom": true,
   "assertions": [
    "status == 200"
   ]
  },
  {
   "name": "auth: POST /oauth2/logout thu hồi phiên của token",
   "endpointId": 9100041,
   "method": "POST",
   "path": "{{authUrl}}/oauth2/logout",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 200"
   ]
  },
  {
   "name": "auth: sau logout /auth/me -> 401",
   "endpointId": 9100042,
   "method": "GET",
   "path": "{{authUrl}}/auth/me",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "assertions": [
    "status == 401"
   ]
  }
 ]
}
