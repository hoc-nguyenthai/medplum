   },
   "relatedId": 988032
  },
  {
   "id": "step-4",
   "number": 4,
   "name": "GET Patient với token sai → 401",
   "type": "customHttp",
   "customHttpRequest": {
    "id": 988031,
    "name": "GET Patient với token sai → 401",
    "path": "/fhir/R4/Patient?_count=1",
    "method": "get",
    "folderId": 0,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "none"
    },
    "preProcessors": [],
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == {{expected_status}}",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "{{expected_status}}"
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "const code = pm.iterationData.get('expected_code'); const msg = pm.iterationData.get('expected_message'); let b = {}; try { b = pm.response.json(); } catch (x) {} const issue = (b.issue && b.issue[0]) || {}; const text = (issue.details && issue.details.text) || (b.errors && b.errors[0] && b.errors[0].message) || ''; if (code) { pm.test('issue.code == ' + code, () => pm.expect(issue.code).to.eql(code)); } if (msg) { pm.test('thông điệp chứa: ' + msg, () => pm.expect(text).to.include(msg)); }"
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "pm.test('header WWW-Authenticate chứa invalid_token', () => pm.expect(pm.response.headers.get('WWW-Authenticate') || '').to.include('invalid_token'));"
     }
    ],
    "auth": {
     "type": "bearer",
     "bearer": {
      "token": "{{bad_token}}"
     }
    },
    "advancedSettings": {},
    "commonParameters": {},
    "projectId": 1380475
   },
   "relatedId": 988031
  },
  {
