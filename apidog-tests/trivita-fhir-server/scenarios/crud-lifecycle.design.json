{
 "slug": "crud-lifecycle",
 "name": "Vòng đời Patient (CRUD, history, vread, patch, expunge)",
 "priority": 0,
 "steps": [
  {
   "name": "Đăng nhập admin project (auth /auth/login)",
   "endpointId": "auth-login",
   "method": "POST",
   "path": "{{authUrl}}/auth/login",
   "body": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\", \"clientId\": \"{{clientId}}\", \"scope\": \"openid profile email\"}",
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.code exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "adm_code",
      "expression": "$.code",
      "subject": "responseJson"
     }
    }
   ]
  },
  {
   "name": "Đổi code lấy token admin (authorization_code)",
   "endpointId": "auth-token",
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "form": {
    "grant_type": "authorization_code",
    "code": "{{adm_code}}",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "auth": "none",
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "bearerToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "POST Patient",
   "endpointId": 47548496,
   "method": "POST",
   "path": "/fhir/R4/Patient",
   "body": "{\"resourceType\": \"Patient\", \"name\": [{\"family\": \"{{family}}-{{$timestamp}}\", \"given\": [\"{{given}}\"]}], \"gender\": \"{{gender}}\", \"birthDate\": \"{{birth_date}}\"}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 201",
    "$.resourceType == Patient",
    "$.id exists",
    "$.meta.versionId exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "patient_id",
      "expression": "$.id",
      "subject": "responseJson"
     }
    },
    {
     "type": "extractor",
     "data": {
      "variableName": "v1",
      "expression": "$.meta.versionId",
      "subject": "responseJson"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('header Location chứa /_history/', () => pm.expect(pm.response.headers.get('Location') || '').to.include('/_history/'));"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('header ETag chứa W/\"', () => pm.expect(pm.response.headers.get('ETag') || '').to.include('W/\"'));"
     }
    }
   ],
   "custom": true
  },
  {
   "name": "GET Patient/{id}",
   "endpointId": 47548498,
   "method": "GET",
   "path": "/fhir/R4/Patient/{{patient_id}}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200",
    "$.id == {{patient_id}}",
    "$.meta.versionId == {{v1}}"
   ]
  },
  {
   "name": "PUT Patient/{id} (đổi gender)",
   "endpointId": 47548499,
   "method": "PUT",
   "path": "/fhir/R4/Patient/{{patient_id}}",
   "body": "{\"resourceType\": \"Patient\", \"name\": [{\"family\": \"{{family}}-{{$timestamp}}\", \"given\": [\"{{given}}\"]}], \"gender\": \"unknown\", \"birthDate\": \"{{birth_date}}\", \"id\": \"{{patient_id}}\"}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200",
    "$.gender == unknown"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "v2",
      "expression": "$.meta.versionId",
      "subject": "responseJson"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('versionId đổi sau PUT', () => pm.expect(pm.response.json().meta.versionId).to.not.eql(pm.variables.get('v1')));"
     }
    }
   ]
  },
  {
   "name": "GET _history (2 phiên bản)",
   "endpointId": 47548502,
   "method": "GET",
   "path": "/fhir/R4/Patient/{{patient_id}}/_history",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200",
    "$.resourceType == Bundle",
    "$.type == history"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('2 entry', () => pm.expect(pm.response.json().entry.length).to.eql(2));"
     }
    }
   ]
  },
  {
   "name": "GET _history/{v1} (vread bản đầu)",
   "endpointId": 47548503,
   "method": "GET",
   "path": "/fhir/R4/Patient/{{patient_id}}/_history/{{v1}}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200",
    "$.meta.versionId == {{v1}}",
    "$.gender == {{gender}}"
   ]
  },
  {
   "name": "PATCH Patient/{id} (JSON Patch)",
   "endpointId": 47548501,
   "method": "PATCH",
   "path": "/fhir/R4/Patient/{{patient_id}}",
   "headers": {
    "Content-Type": "application/json-patch+json"
   },
   "body": "[{\"op\": \"replace\", \"path\": \"/gender\", \"value\": \"other\"}]",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200",
    "$.gender == other"
   ],
   "custom": true
  },
  {
   "name": "DELETE Patient/{id} → 204",
   "endpointId": 47548500,
   "method": "DELETE",
   "path": "/fhir/R4/Patient/{{patient_id}}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 204"
   ],
   "custom": true
  },
  {
   "name": "GET Patient đã xóa → 410",
   "endpointId": 47548498,
   "method": "GET",
   "path": "/fhir/R4/Patient/{{patient_id}}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 410",
    "$.issue[0].code == deleted"
   ],
   "custom": true
  },
  {
   "name": "DELETE lần hai → 204 (không sinh phiên bản)",
   "endpointId": 47548500,
   "method": "DELETE",
   "path": "/fhir/R4/Patient/{{patient_id}}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 204"
   ],
   "custom": true
  },
  {
   "name": "GET _history sau xóa (4 phiên bản)",
   "endpointId": 47548502,
   "method": "GET",
   "path": "/fhir/R4/Patient/{{patient_id}}/_history",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200",
    "$.type == history"
   ],
   "postProcessors": [
    {
     "type": "customScript",
     "data": {
      "script": "pm.test('4 entry: create, put, patch, delete', () => pm.expect(pm.response.json().entry.length).to.eql(4));"
     }
    }
   ]
  },
  {
   "name": "POST $expunge → 200",
   "endpointId": 47548517,
   "method": "POST",
   "path": "/fhir/R4/Patient/{{patient_id}}/$expunge",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 200",
    "$.resourceType == OperationOutcome"
   ]
  },
  {
   "name": "GET sau expunge → 404",
   "endpointId": 47548498,
   "method": "GET",
   "path": "/fhir/R4/Patient/{{patient_id}}",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 404",
    "$.issue[0].code == not-found"
   ],
   "custom": true
  },
  {
   "name": "POST $expunge lần hai → 404",
   "endpointId": 47548517,
   "method": "POST",
   "path": "/fhir/R4/Patient/{{patient_id}}/$expunge",
   "auth": "Bearer {{bearerToken}}",
   "assertions": [
    "status == 404"
   ],
   "custom": true
  }
 ]
}
