{
 "slug": "full-flow-negative-bad-token",
 "name": "Full flow negative: token sai → 401 trên cả 4 service",
 "priority": 1,
 "steps": [
  {
   "name": "auth: token hợp lệ (đối chứng)",
   "endpointId": 9100056,
   "method": "POST",
   "path": "{{authUrl}}/oauth2/token",
   "auth": "none",
   "custom": true,
   "form": {
    "grant_type": "client_credentials",
    "client_id": "{{clientId}}",
    "client_secret": "{{clientSecret}}"
   },
   "assertions": [
    "status == 200",
    "$.access_token exists"
   ],
   "postProcessors": [
    {
     "type": "extractor",
     "data": {
      "variableName": "accessToken",
      "expression": "$.access_token",
      "subject": "responseJson"
     }
    },
    {
     "type": "customScript",
     "data": {
      "script": "const k = pm.iterationData.get('bad_kind'); const m = {garbage: 'not-a-jwt', 'three-parts': 'aaa.bbb.ccc', sqli: \"' OR '1'='1\", 'bearer-word': 'Bearer', long: 'A'.repeat(4096),\n  'alg-none': ['eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0', 'eyJzdWIiOiJxYSJ9', ''].join('.')};\npm.variables.set('bad_token', m[k]);"
     }
    }
   ]
  },
  {
   "name": "đối chứng: fhir GET Patient với token hợp lệ -> 200",
   "endpointId": 9100057,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/Patient",
   "auth": "Bearer {{accessToken}}",
   "custom": true,
   "query": {
    "_count": "1"
   },
   "assertions": [
    "status == 200"
   ]
  },
  {
   "name": "auth: GET /auth/me với token sai -> 401",
   "endpointId": 9100058,
   "method": "GET",
   "path": "{{authUrl}}/auth/me",
   "auth": "Bearer {{bad_token}}",
   "custom": true,
   "assertions": [
    "status == {{expected_status}}"
   ]
  },
  {
   "name": "fhir: GET /fhir/R4/Patient với token sai -> 401",
   "endpointId": 9100059,
   "method": "GET",
   "path": "{{fhirUrl}}/fhir/R4/Patient",
   "auth": "Bearer {{bad_token}}",
   "custom": true,
   "assertions": [
    "status == {{expected_status}}"
   ]
  },
  {
   "name": "dicomweb: GET /dicomweb/studies với token sai -> 401",
   "endpointId": 9100060,
   "method": "GET",
   "path": "{{dicomUrl}}/dicomweb/studies",
   "auth": "Bearer {{bad_token}}",
   "custom": true,
   "assertions": [
    "status == {{expected_status}}"
   ]
  },
  {
   "name": "ws-gateway: GET /fhircast/STU3/{topic} với token sai -> 401",
   "endpointId": 9100061,
   "method": "GET",
   "path": "{{wsUrl}}/fhircast/STU3/qa-no-token",
   "auth": "Bearer {{bad_token}}",
   "custom": true,
   "assertions": [
    "status == {{expected_status}}"
   ]
  }
 ]
}
