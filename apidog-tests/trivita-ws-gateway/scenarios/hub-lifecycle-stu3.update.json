{
 "steps": [
  {
   "id": "step-1",
   "number": 1,
   "name": "Chuẩn bị: lấy token client_credentials từ auth và đặt topic",
   "type": "http",
   "bindType": "API",
   "syncMode": "MANUAL",
   "bindId": 47548561,
   "httpApiCase": {
    "type": "DEBUG_CASE",
    "name": "Chuẩn bị: lấy token client_credentials từ auth và đặt topic",
    "path": "/healthz",
    "method": "get",
    "apiDetailId": 47548561,
    "projectId": 1380475,
    "parameters": {
     "path": [],
     "query": [],
     "header": [],
     "cookie": []
    },
    "requestBody": {
     "type": "none"
    },
    "postProcessors": [
     {
      "type": "assertion",
      "enable": true,
      "data": {
       "name": "status == 200",
       "subject": "httpCode",
       "comparison": "equal",
       "path": "",
       "value": "200"
      }
     },
     {
      "type": "customScript",
      "enable": true,
      "data": "\nconst scope = pm.iterationData.get('oauth_scope') || 'fhircast/*';\nconst authUrl = pm.variables.get('authUrl') || pm.environment.get('authUrl');\nconst set = (k, v) => { try { pm.variables.set(k, v); } catch (e) {} try { pm.environment.set(k, v); } catch (e) {} };\nset('topic', 'qa-' + Date.now() + '-' + Math.floor(Math.random() * 1000000));\npm.sendRequest({\n  url: authUrl + '/oauth2/token', method: 'POST',\n  header: { 'Content-Type': 'application/x-www-form-urlencoded' },\n  body: { mode: 'urlencoded', urlencoded: [\n    { key: 'grant_type', value: 'client_credentials' },\n    { key: 'client_id', value: pm.variables.get('clientId') || pm.environment.get('clientId') },\n    { key: 'client_secret', value: pm.variables.get('clientSecret') || pm.environment.get('clientSecret') },\n    { key: 'scope', value: scope } ] }\n}, (err, res) => {\n  pm.test('token client_credentials 200', () => { pm.expect(err).to.eql(null); pm.expect(res.code).to.eql(200); });\n  if (!err && res.code === 200) { set('access_token', res.json().access_token); }\n});\n"
     }
    ],
    "auth": {
     "type": "noauth"
    },
    "id": 65401425
   },
   "relatedId": 65401425
  },
