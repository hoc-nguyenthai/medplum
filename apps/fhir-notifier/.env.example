# fhir-notifier: mẫu cấu hình. Biến chung với fhir-server giữ NGUYÊN tên để dùng chung một tệp môi trường (xem docs/config.md).
# Copy thành .env (đọc khi chạy ở thư mục này; không ghi đè biến môi trường thật).

# Tên service trong log và telemetry (OTEL_SERVICE_NAME thắng nếu đặt).
# APP_NAME=trivita-fhir-notifier
# Địa chỉ nghe của các probe (service không có route nghiệp vụ).
# HTTP_ADDR=:8010
# local | development | staging | production (staging/production áp ràng buộc chặt).
# ENVIRONMENT=local

# Hạn tối đa của /health/ready khi kiểm database và Redis.
# READINESS_TIMEOUT=2s
# Sau SIGTERM: readiness 503 nhưng vẫn chạy, để orchestrator gỡ instance.
# SHUTDOWN_DRAIN_DELAY=5s
# Thời gian tối đa chờ lần giao đang chạy bị hủy và dừng sau khi hết drain (terminationGracePeriodSeconds phải lớn hơn tổng hai giá trị).
# SHUTDOWN_TIMEOUT=25s
# Hạn đọc phần đầu HTTP của mỗi yêu cầu probe.
# READ_HEADER_TIMEOUT=10s

# CÙNG schema `fhir` với fhir-server (fhir-notifier không migrate; chạy `fhir-server migrate up` trước).
# DATABASE_URL=postgres://fhir_app:***@postgres:5432/trivita?search_path=fhir
# Ghi log mọi câu SQL (chỉ gỡ lỗi).
# DATABASE_ECHO=false
# Từ chối khởi động nếu search_path không phải đúng một schema riêng (PostgreSQL).
# DATABASE_REQUIRE_SCHEMA=false
# DATABASE_MAX_OPEN_CONNS=20
# DATABASE_MAX_IDLE_CONNS=5
# DATABASE_CONN_MAX_LIFETIME=30m

# Redis của broker sự kiện (bắt buộc), cùng Redis với fhir-server (BROKER_DRIVER=redis).
# REDIS_URL=redis://localhost:6379/0
# Consumer group của service này; KHÁC "trivita" của fhir-server để cả hai cùng nhận mọi sự kiện.
# BROKER_GROUP=fhir-notifier
# Sau chừng này một message không được ACK (instance chết giữa lúc giao) thì replica khác nhận lại và giao lại. 0: tự tính (> 2 lần chuỗi giao xấu nhất, tối thiểu 1 phút).
# BROKER_CLAIM_IDLE=0s

# Số sự kiện xử lý song song và số webhook giao song song mỗi sự kiện.
# FHIR_WEBHOOK_WORKERS=4
# Số lần thử tối đa mỗi lần giao (thử lại tại chỗ, chờ 1s nhân đôi mỗi lần, trần 1 phút).
# FHIR_WEBHOOK_MAX_ATTEMPTS=5
# Hạn của mỗi request webhook.
# FHIR_WEBHOOK_TIMEOUT=10s
# CHỈ dev: cho giao tới địa chỉ nội bộ (tắt chống SSRF). Cấm ở staging/production.
# FHIR_WEBHOOK_ALLOW_PRIVATE=false
# JSON mảng trigger tự tắt Subscription giao thất bại lặp lại. Rỗng: không tự tắt.
# FHIR_SUBSCRIPTION_AUTO_DISABLE=[{"maxConsecutiveFailures":10,"timeWindowSeconds":3600}]
# Websocket: off (mặc định) hoặc issuer (khớp rồi phát lên kênh Redis cho ws-gateway; token bind vẫn do fhir-server cấp). embedded không dùng được ở đây.
# FHIR_WS_MODE=off
